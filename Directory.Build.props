<Project>

  <!--
    ============================================================================
    HL PRO OPTIMIZER - Propriedades globais de build (herdadas por todos os
    projetos da solução). Centraliza versão, linguagem e políticas de qualidade.
    ============================================================================
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>

    <!-- Metadados do produto -->
    <Product>HL PRO OPTIMIZER</Product>
    <Company>HL Labs</Company>
    <Authors>HL Labs Engineering</Authors>
    <Copyright>Copyright © 2026 HL Labs</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Qualidade de código -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Artefatos fora do controle de versão -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
