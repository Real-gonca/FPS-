<!--
  ============================================================================
  HL Optimizer Pro — Logótipo e ícones vetoriais próprios
  ============================================================================
  O logótipo "HL" é desenhado em vetor (sem imagens binárias) para:
    • ficar nítido em qualquer resolução e escala de DPI,
    • poder ser colorido dinamicamente pelo tema,
    • não aumentar o tamanho do executável.
  O símbolo é um hexágono (estabilidade) com um velocímetro (desempenho).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Símbolo: hexágono com arco de velocímetro e ponteiro -->
  <GeometryGroup x:Key="LogoMarkGeometry">
    <PathGeometry Figures="M 32,4 L 55,17 L 55,43 L 32,56 L 9,43 L 9,17 Z" />
  </GeometryGroup>

  <GeometryGroup x:Key="LogoGaugeGeometry">
    <PathGeometry Figures="M 17,38 A 15,15 0 0 1 47,38" />
  </GeometryGroup>

  <GeometryGroup x:Key="LogoNeedleGeometry">
    <PathGeometry Figures="M 32,38 L 42,27" />
  </GeometryGroup>

  <!-- Desenho completo (usado no Splash e na tela Sobre) -->
  <DrawingImage x:Key="LogoImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Hexágono com preenchimento em gradiente azul -->
        <GeometryDrawing Geometry="{StaticResource LogoMarkGeometry}">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF1E6BFF" Offset="0" />
              <GradientStop Color="#FF0B1530" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#FF4C9BFF" Thickness="2.5" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Arco de velocímetro -->
        <GeometryDrawing Geometry="{StaticResource LogoGaugeGeometry}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FF9ED0FF" Thickness="3" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Ponteiro -->
        <GeometryDrawing Geometry="{StaticResource LogoNeedleGeometry}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FF21C97A" Thickness="3" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- Centro do velocímetro -->
        <GeometryDrawing Brush="#FFE6EDF7" Geometry="M 30,36 A 2.5,2.5 0 1 1 34,36 A 2.5,2.5 0 1 1 30,36 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- Marca compacta (barra lateral, cabeçalho) -->
  <DrawingImage x:Key="LogoMarkSmall">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="{StaticResource LogoMarkGeometry}">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF2D7BFF" Offset="0" />
              <GradientStop Color="#FF0F4AD1" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource LogoGaugeGeometry}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFE6EDF7" Thickness="3.4" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource LogoNeedleGeometry}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FF21C97A" Thickness="3.4" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

</ResourceDictionary>
