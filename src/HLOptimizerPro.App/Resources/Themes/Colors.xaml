<!--
  ============================================================================
  HL Optimizer Pro — Paleta de cores (dicionário base do design system)
  ============================================================================
  Regra: nenhuma View define cores "à mão". Tudo vem daqui, o que garante
  consistência e permite trocar o tema num único ficheiro.

  Fundo azul-marinho escuro: #070D1F → #0B1530
  Destaque azul elétrico:     #1E6BFF / #2D7BFF (com glow suave)
  Estados: verde #21C97A (ótimo), amarelo #F2B93B (atenção), vermelho #FF4D5E (crítico)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================ FUNDOS ============================ -->
  <Color x:Key="ColorBgDeep">#FF070D1F</Color>
  <Color x:Key="ColorBgBase">#FF0B1530</Color>
  <Color x:Key="ColorBgElevated">#FF101C3D</Color>
  <Color x:Key="ColorBgSunken">#FF050A18</Color>
  <Color x:Key="ColorSidebar">#FF081026</Color>

  <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}" />
  <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource ColorBgBase}" />
  <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />
  <SolidColorBrush x:Key="BrushBgSunken" Color="{StaticResource ColorBgSunken}" />
  <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />

  <!-- Fundo principal com leve gradiente diagonal (profundidade sem ruído visual) -->
  <LinearGradientBrush x:Key="BrushAppBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF070D1F" Offset="0" />
    <GradientStop Color="#FF0B1530" Offset="0.55" />
    <GradientStop Color="#FF070D1F" Offset="1" />
  </LinearGradientBrush>

  <!-- ======================= VIDRO (PAINÉIS) ======================== -->
  <!-- Cards "vidro": fundo translúcido + borda azul translúcida -->
  <SolidColorBrush x:Key="BrushGlassPanel" Color="#B20E1A38" />
  <SolidColorBrush x:Key="BrushGlassPanelHover" Color="#CC12224A" />
  <SolidColorBrush x:Key="BrushGlassBorder" Color="#3D1E6BFF" />
  <SolidColorBrush x:Key="BrushGlassBorderStrong" Color="#661E6BFF" />
  <SolidColorBrush x:Key="BrushGlassHighlight" Color="#14FFFFFF" />

  <LinearGradientBrush x:Key="BrushGlassSheen" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1AFFFFFF" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="0.35" />
  </LinearGradientBrush>

  <!-- ========================= DESTAQUE ============================= -->
  <Color x:Key="ColorAccent">#FF1E6BFF</Color>
  <Color x:Key="ColorAccentBright">#FF2D7BFF</Color>
  <Color x:Key="ColorAccentDeep">#FF0F4AD1</Color>

  <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
  <SolidColorBrush x:Key="BrushAccentBright" Color="{StaticResource ColorAccentBright}" />
  <SolidColorBrush x:Key="BrushAccentDeep" Color="{StaticResource ColorAccentDeep}" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="#331E6BFF" />
  <SolidColorBrush x:Key="BrushAccentSubtle" Color="#1A1E6BFF" />

  <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1E6BFF" Offset="0" />
    <GradientStop Color="#FF2D7BFF" Offset="0.6" />
    <GradientStop Color="#FF4C9BFF" Offset="1" />
  </LinearGradientBrush>

  <!-- ====================== ESTADOS / SAÚDE ========================= -->
  <Color x:Key="ColorSuccess">#FF21C97A</Color>
  <Color x:Key="ColorWarning">#FFF2B93B</Color>
  <Color x:Key="ColorDanger">#FFFF4D5E</Color>
  <Color x:Key="ColorInfo">#FF43A0FF</Color>
  <Color x:Key="ColorPurple">#FF9B6BFF</Color>

  <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
  <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
  <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />
  <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource ColorPurple}" />

  <SolidColorBrush x:Key="BrushSuccessSoft" Color="#2621C97A" />
  <SolidColorBrush x:Key="BrushWarningSoft" Color="#26F2B93B" />
  <SolidColorBrush x:Key="BrushDangerSoft" Color="#26FF4D5E" />
  <SolidColorBrush x:Key="BrushInfoSoft" Color="#2643A0FF" />

  <!-- Gradientes dos gauges: cada métrica tem a sua identidade visual -->
  <LinearGradientBrush x:Key="BrushGaugeCpu" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF2D7BFF" Offset="0" />
    <GradientStop Color="#FF7FC6FF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrushGaugeRam" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF9B6BFF" Offset="0" />
    <GradientStop Color="#FFC9A8FF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrushGaugeGpu" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF21C97A" Offset="0" />
    <GradientStop Color="#FF8CF0C4" Offset="1" />
  </LinearGradientBrush>

  <!-- ========================== TEXTO ============================== -->
  <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFE6EDF7" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#FF8FA3C8" />
  <SolidColorBrush x:Key="BrushTextMuted" Color="#FF63779C" />
  <SolidColorBrush x:Key="BrushTextDisabled" Color="#FF4A5A78" />
  <SolidColorBrush x:Key="BrushTextOnAccent" Color="#FFFFFFFF" />

  <!-- ====================== BORDAS / DIVISORES ====================== -->
  <SolidColorBrush x:Key="BrushBorderSubtle" Color="#1F4468B0" />
  <SolidColorBrush x:Key="BrushBorder" Color="#332D7BFF" />
  <SolidColorBrush x:Key="BrushBorderStrong" Color="#552D7BFF" />
  <SolidColorBrush x:Key="BrushDivider" Color="#1A8FA3C8" />

  <!-- =================== CAMPOS DE FORMULÁRIO ====================== -->
  <SolidColorBrush x:Key="BrushInputBackground" Color="#CC0A1428" />
  <SolidColorBrush x:Key="BrushInputBorder" Color="#332D7BFF" />
  <SolidColorBrush x:Key="BrushInputBorderFocus" Color="#CC2D7BFF" />

  <!-- ===================== EFEITOS (GLOW/VIDRO) ===================== -->
  <!-- Glow azul suave usado no botão primário, gauges ativos e elementos em foco -->
  <DropShadowEffect x:Key="EffectGlowAccent" Color="#FF1E6BFF" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
  <DropShadowEffect x:Key="EffectGlowSuccess" Color="#FF21C97A" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
  <DropShadowEffect x:Key="EffectGlowWarning" Color="#FFF2B93B" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
  <DropShadowEffect x:Key="EffectGlowDanger" Color="#FFFF4D5E" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
  <!-- Sombra dos painéis: dá a sensação de "vidro" elevado sobre o fundo -->
  <DropShadowEffect x:Key="EffectPanelShadow" Color="#FF000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" />
  <DropShadowEffect x:Key="EffectSoftShadow" Color="#FF000000" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35" />

  <!-- ========================= RADIUS / ESPAÇO ====================== -->
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusCardSmall">10</CornerRadius>
  <CornerRadius x:Key="RadiusButton">10</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <Thickness x:Key="PaddingCard">18</Thickness>
  <Thickness x:Key="PaddingCardCompact">14</Thickness>
  <Thickness x:Key="MarginSection">0,0,0,16</Thickness>

</ResourceDictionary>
