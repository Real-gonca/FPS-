<!--
  ============================================================================
  Janela principal (shell) do HL Optimizer Pro
  ============================================================================
  Estrutura:
    • Barra de título personalizada (logótipo, título da página, Modo Simular,
      minimizar / maximizar / fechar) — usa WindowChrome, por isso o arrastar,
      o duplo-clique para maximizar e o redimensionar funcionam como no Windows.
    • Barra lateral fixa à esquerda com a navegação completa (Início, Avaliação,
      Ferramentas com submenu, Otimizações, Recomendações, Configuração, Ajuda).
    • Área de conteúdo onde cada página é injetada (transição suave).
    • Rodapé de estado + zona de notificações (toasts).
-->
<Window x:Class="HLOptimizerPro.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="HL Optimizer Pro"
        Width="1360" Height="860"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushAppBackground}"
        FontFamily="{StaticResource FontBody}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- ===================== BARRA DE TÍTULO PERSONALIZADA ===================== -->
    <Border Grid.Row="0"
            Background="{StaticResource BrushBgDeep}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Identidade -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,18,0" VerticalAlignment="Center">
          <Image Source="{StaticResource LogoMarkSmall}" Width="24" Height="24" />
          <TextBlock Text="HL Optimizer Pro" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushTextPrimary}" Margin="9,0,0,0" VerticalAlignment="Center" />
          <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="7,1">
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource BadgeText}" FontSize="10" />
          </Border>
        </StackPanel>

        <!-- Voltar + título da página atual -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ButtonIcon}"
                  Width="30" Height="28"
                  Margin="0,0,4,0"
                  ToolTip="Voltar à página anterior"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Command="{Binding GoBackCommand}">
            <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="15" Height="15" />
          </Button>
          <TextBlock Text="{Binding CurrentPage.Title}"
                     Foreground="{StaticResource BrushTextSecondary}"
                     FontSize="12.5"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Modo Simular + controlos da janela -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
          <Border Margin="0,0,10,0"
                  Padding="10,3"
                  CornerRadius="{StaticResource RadiusPill}"
                  Background="{StaticResource BrushWarningSoft}"
                  BorderBrush="{StaticResource BrushWarning}"
                  BorderThickness="1"
                  Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="EyeOutline" Width="12" Height="12"
                                          Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" />
              <TextBlock Text="Modo Simular ativo" FontSize="10.5" Margin="5,0,0,0"
                         Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <CheckBox Style="{StaticResource ToggleSwitch}"
                    Content="Simular"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    IsChecked="{Binding IsSimulationMode, Mode=TwoWay}"
                    ToolTip="Modo Simular: mostra o que seria alterado sem tocar no sistema" />

          <Button Style="{StaticResource ButtonWindowControl}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Minimizar"
                  Click="OnMinimizeClick">
            <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="14" Height="14" />
          </Button>
          <Button x:Name="MaximizeButton"
                  Style="{StaticResource ButtonWindowControl}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Maximizar"
                  Click="OnMaximizeClick">
            <iconPacks:PackIconMaterial x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14" />
          </Button>
          <Button Style="{StaticResource ButtonClose}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Fechar"
                  Click="OnCloseClick">
            <iconPacks:PackIconMaterial Kind="Close" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== CORPO: BARRA LATERAL + CONTEÚDO ===================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="246" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ====== BARRA LATERAL ====== -->
      <Border Grid.Column="0"
              Background="{StaticResource BrushSidebar}"
              BorderBrush="{StaticResource BrushBorderSubtle}"
              BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <ScrollViewer Grid.Row="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,10,0,10">
            <ItemsControl ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <!-- Item de topo -->
                    <RadioButton Style="{StaticResource NavButton}"
                                 GroupName="SidebarNav"
                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding Key}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                                    Width="17" Height="17"
                                                    VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center" />
                        <iconPacks:PackIconMaterial Grid.Column="2"
                                                    Kind="ChevronDown"
                                                    Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource BrushTextMuted}"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                          <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                              <Setter Property="RenderTransform">
                                <Setter.Value>
                                  <RotateTransform Angle="0" CenterX="7" CenterY="7" />
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                  <Setter Property="RenderTransform">
                                    <Setter.Value>
                                      <RotateTransform Angle="180" CenterX="7" CenterY="7" />
                                    </Setter.Value>
                                  </Setter>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </iconPacks:PackIconMaterial.Style>
                        </iconPacks:PackIconMaterial>
                      </Grid>
                    </RadioButton>

                    <!-- Submenu (Ferramentas) -->
                    <ItemsControl ItemsSource="{Binding Children}"
                                  Margin="16,0,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <RadioButton Style="{StaticResource NavButton}"
                                       GroupName="SidebarNav"
                                       Padding="12,7"
                                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                       Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding Key}">
                            <StackPanel Orientation="Horizontal">
                              <iconPacks:PackIconMaterial Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                                          Width="14" Height="14"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource BrushTextMuted}" />
                              <TextBlock Text="{Binding Label}" Margin="11,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                          </RadioButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Rodapé da barra lateral: utilizador, licença, elevação -->
          <Border Grid.Row="1"
                  BorderBrush="{StaticResource BrushBorderSubtle}"
                  BorderThickness="0,1,0,0"
                  Padding="14,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17"
                        Background="{StaticResource BrushAccentGradient}">
                  <TextBlock Text="{Binding Initials}"
                             Foreground="{StaticResource BrushTextOnAccent}"
                             FontWeight="SemiBold"
                             FontSize="12.5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding UserProfile}" Style="{StaticResource Caption}" />
                </StackPanel>
              </StackPanel>

              <Grid Margin="0,10,0,0">
                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="StarFourPoints" Width="11" Height="11"
                                                Foreground="{StaticResource BrushAccentBright}"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LicenseText}" Style="{StaticResource BadgeText}" Margin="5,0,0,0" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Badge}"
                        HorizontalAlignment="Right"
                        Background="{Binding PrivilegeLevel, Converter={StaticResource HealthToSoftBrush}}"
                        BorderBrush="{Binding PrivilegeLevel, Converter={StaticResource HealthToBrush}}">
                  <TextBlock Text="{Binding PrivilegeText}"
                             Style="{StaticResource BadgeText}"
                             Foreground="{Binding PrivilegeLevel, Converter={StaticResource HealthToBrush}}" />
                </Border>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ====== CONTEÚDO ====== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho da página -->
        <Border Grid.Row="0" Padding="26,18,26,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40"
                    CornerRadius="12"
                    Background="{StaticResource BrushAccentSubtle}"
                    BorderBrush="{StaticResource BrushGlassBorder}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <iconPacks:PackIconMaterial Kind="{Binding CurrentPage.IconKind, Converter={StaticResource IconKind}}"
                                          Width="20" Height="20"
                                          Foreground="{StaticResource BrushAccentBright}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource H2}" />
              <TextBlock Text="{Binding CurrentPage.Subtitle}"
                         Style="{StaticResource Caption}"
                         Margin="0,2,0,0"
                         Visibility="{Binding CurrentPage.Subtitle, Converter={StaticResource EmptyStringToVisibility}}" />
            </StackPanel>

            <!-- Indicador de ocupação da página -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="220"
                        Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding CurrentPage.BusyMessage}"
                         Style="{StaticResource Caption}"
                         HorizontalAlignment="Right"
                         Margin="0,0,0,5" />
              <ProgressBar Style="{StaticResource LoadingBar}" IsIndeterminate="True" Height="3" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Anfitrião das páginas: o ViewLocator troca a View quando o ViewModel muda -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="26,0,26,18" />
      </Grid>

      <!-- ====== NOTIFICAÇÕES (toasts) ====== -->
      <StackPanel Grid.Column="1"
                  x:Name="ToastHost"
                  Width="330"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,10,18,0"
                  Panel.ZIndex="20">
        <ItemsControl ItemsSource="{Binding Toasts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10"
                      CornerRadius="12"
                      Padding="13,11"
                      Background="{StaticResource BrushBgElevated}"
                      BorderThickness="1"
                      Effect="{StaticResource EffectSoftShadow}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushGlassBorder}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Level}" Value="Erro">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Aviso">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushWarning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Sucesso">
                        <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Border.RenderTransform>
                  <TranslateTransform X="0" />
                </Border.RenderTransform>
                <Border.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource ToastIn}" />
                  </EventTrigger>
                </Border.Triggers>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <iconPacks:PackIconMaterial Grid.Column="0"
                                              Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                              Width="17" Height="17"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"
                                              Foreground="{Binding Level, Converter={StaticResource NotificationToBrush}}" />
                  <StackPanel Grid.Column="1" Margin="10,0,8,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Style="{StaticResource ButtonIcon}"
                          Width="22" Height="22"
                          VerticalAlignment="Top"
                          ToolTip="Fechar"
                          Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <!-- ===================== RODAPÉ DE ESTADO ===================== -->
    <Border Grid.Row="2"
            Background="{StaticResource BrushBgDeep}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6"
                   Fill="{Binding Shell.SystemState, Converter={StaticResource HealthToBrush}}"
                   VerticalAlignment="Center" />
          <TextBlock Text="{Binding Shell.SystemStateText}"
                     Style="{StaticResource Caption}"
                     Margin="7,0,14,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding CurrentPage.StatusMessage}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="620">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPage.HasError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding Shell.IsGameModeActive, Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,14,0">
            <iconPacks:PackIconMaterial Kind="ControllerClassic" Width="12" Height="12"
                                        Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
            <TextBlock Text="Modo Jogo ativo" Style="{StaticResource Caption}"
                       Foreground="{StaticResource BrushSuccess}" Margin="5,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ClockText}" Style="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
