<!--
  ============================================================================
  Ferramenta Memória RAM (3.4-a)
  ============================================================================
  Gauge de RAM + detalhe (total, livre, em cache, standby, modificadas, ficheiro de paginação),
  pressão de memória, as quatro limpezas reais, lista dos processos que mais memória ocupam
  (com proteção de processos críticos) e a dica de manter pelo menos 20 % livre.
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:HLOptimizerPro.App.Controls"
             Style="{StaticResource PageTransition}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel>

      <!-- ===================== GAUGE + DETALHE ===================== -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18">
          <StackPanel>
            <controls:GaugeControl Value="{Binding UsagePercent}"
                                   ValueText="{Binding UsageText}"
                                   SubText="{Binding FreeRamPercentText}"
                                   Title="Memória RAM"
                                   AccentBrush="{StaticResource BrushGaugeRam}"
                                   Width="196" Height="196" />

            <Border Style="{StaticResource Badge}"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Background="{Binding PressureLevel, Converter={StaticResource HealthToSoftBrush}}"
                    BorderBrush="{Binding PressureLevel, Converter={StaticResource HealthToBrush}}">
              <TextBlock Text="{Binding PressureText}"
                         Style="{StaticResource BadgeText}"
                         Foreground="{Binding PressureLevel, Converter={StaticResource HealthToBrush}}"
                         MaxWidth="230"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="20,18">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="ChartDonut" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Detalhe da memória" Style="{StaticResource H3}" Margin="9,0,0,0" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="0,14,0,0">
              <StackPanel Margin="0,0,14,14">
                <TextBlock Text="Total instalada" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding TotalText}" Style="{StaticResource MetricValueSmall}" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Margin="0,0,14,14">
                <TextBlock Text="Livre (disponível)" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding AvailableText}" Style="{StaticResource MetricValueSmall}" Margin="0,3,0,0"
                           Foreground="{StaticResource BrushSuccess}" />
              </StackPanel>
              <StackPanel Margin="0,0,14,14">
                <TextBlock Text="Em cache" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding CachedText}" Style="{StaticResource MetricValueSmall}" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Standby (em espera)" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding StandbyText}" Style="{StaticResource MetricValueSmall}" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Páginas modificadas" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource MetricValueSmall}" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Ficheiro de paginação" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding PageFileText}" Style="{StaticResource MetricValueSmall}" Margin="0,3,0,0" />
              </StackPanel>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource CardCompact}" Margin="0,6,0,0"
                    Background="{StaticResource BrushAccentSubtle}"
                    BorderBrush="{StaticResource BrushGlassBorder}">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" Width="16" Height="16"
                                            Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding TipText}" Style="{StaticResource Caption}" Margin="10,0,0,0"
                           TextWrapping="Wrap" MaxWidth="520" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ===================== AÇÕES DE LIMPEZA ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="AutoFix" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Libertar memória" Style="{StaticResource H3}" Margin="9,0,0,0" />
            </StackPanel>
            <Button Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right"
                    Content="Reduzir Uso de RAM (tudo)"
                    Command="{Binding ReleaseAllCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Actions}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardCompact}" Margin="4" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding CurrentValue, StringFormat={}Atual: {0}}"
                               Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding NewValue, StringFormat={}Depois: {0}}"
                               Style="{StaticResource Caption}"
                               Foreground="{StaticResource BrushSuccess}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Risk}" Style="{StaticResource Caption}"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Button Style="{StaticResource ButtonSmall}"
                            Margin="0,10,0,0"
                            Content="Executar"
                            HorizontalAlignment="Left"
                            Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Key}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding LastOptimizationText}" Style="{StaticResource Caption}" Margin="4,12,0,0" />
        </StackPanel>
      </Border>

      <!-- ===================== TOP PROCESSOS ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="Apps" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Processos que mais memória ocupam" Style="{StaticResource H3}" Margin="9,0,0,0" />
              <TextBlock Text="(medido agora)" Style="{StaticResource Caption}" Margin="8,3,0,0" />
            </StackPanel>

            <Button Style="{StaticResource ButtonGhost}"
                    HorizontalAlignment="Right"
                    Content="Atualizar"
                    Command="{Binding RefreshNowCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding TopProcesses}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8"
                          Background="{StaticResource BrushBgSunken}"
                          BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                    <iconPacks:PackIconMaterial Kind="Application"
                                                Width="13" Height="13"
                                                Foreground="{StaticResource BrushTextSecondary}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>

                  <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Description, Converter={StaticResource EmptyStringToVisibility}}" />
                  </StackPanel>

                  <controls:MetricBar Grid.Column="2"
                                      Value="{Binding PercentOfRam}"
                                      Fill="{StaticResource BrushGaugeRam}"
                                      Height="6"
                                      VerticalAlignment="Center" />

                  <TextBlock Grid.Column="3" Text="{Binding MemoryText}"
                             Style="{StaticResource Mono}" FontSize="11.5"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center" />

                  <TextBlock Grid.Column="4" Text="{Binding PidText}"
                             Style="{StaticResource Caption}" Margin="12,0,12,0" VerticalAlignment="Center" />

                  <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="Protegido" Style="{StaticResource BadgeText}" />
                    </Border>
                    <Button Style="{StaticResource ButtonSmallSecondary}"
                            Content="Encerrar"
                            Command="{Binding DataContext.TerminateProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Os processos do Windows marcados como críticos nunca são encerrados pela aplicação, mesmo a pedido."
                     Style="{StaticResource Caption}"
                     Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
