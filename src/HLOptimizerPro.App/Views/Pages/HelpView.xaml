<!--
  ============================================================================
  Ajuda (3.9)
  ============================================================================
  Guia «Como Usar» passo a passo, perguntas frequentes com pesquisa, suporte (e-mail, site,
  documentação e vídeos), exportação do diagnóstico e acesso direto aos logs.
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{StaticResource PageTransition}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== SUPORTE ===================== -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Precisa de ajuda?" Style="{StaticResource H1}" FontSize="23" />
          <TextBlock Text="Comece pelas perguntas frequentes: cobrem o funcionamento das otimizações, a segurança, a reversão e a privacidade."
                     Style="{StaticResource Secondary}" Margin="0,6,0,0"
                     TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding SupportEmail, StringFormat={}E-mail: {0}}" Style="{StaticResource Mono}"
                       FontSize="11" Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
            <Button Style="{StaticResource ButtonGhost}" Content="Copiar" Margin="8,0,0,0"
                    Padding="6,2" Command="{Binding CopySupportEmailCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Style="{StaticResource ButtonPrimary}" Content="Abrir Suporte"
                  MinWidth="170" Height="42"
                  Command="{Binding OpenSupportCommand}" />
          <Button Style="{StaticResource ButtonSecondary}" Content="Exportar diagnóstico"
                  Margin="0,8,0,0"
                  Command="{Binding ExportDiagnosticsCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          <Button Style="{StaticResource ButtonGhost}" Content="Abrir pasta de logs"
                  Margin="0,4,0,0"
                  Command="{Binding OpenLogsFolderCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== CONTEÚDO ===================== -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1.25*" />
      </Grid.ColumnDefinitions>

      <!-- Como usar -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="SchoolOutline" Width="16" Height="16"
                                        Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
            <TextBlock Text="Como usar" Style="{StaticResource H3}" Margin="9,0,0,0" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                            Background="{StaticResource BrushAccentSubtle}"
                            BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="12.5"
                                 Foreground="{StaticResource BrushAccentBright}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                                    Width="14" Height="14"
                                                    Foreground="{StaticResource BrushTextSecondary}"
                                                    VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                   Margin="7,0,0,0" />
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                 TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource ButtonSmallSecondary}" Content="Documentação"
                    Margin="0,0,8,0" Command="{Binding OpenDocsCommand}" />
            <Button Style="{StaticResource ButtonSmallSecondary}" Content="Vídeos"
                    Command="{Binding OpenVideosCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- FAQ -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="FrequentlyAskedQuestions" Width="16" Height="16"
                                        Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
            <TextBlock Text="Perguntas frequentes" Style="{StaticResource H3}" Margin="9,0,0,0" />
          </StackPanel>

          <TextBox Grid.Row="1" Margin="0,12,0,10"
                   Text="{Binding FaqFilter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Pesquisar nas perguntas e respostas" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding FilteredFaq}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Margin="0,0,0,8" Foreground="{StaticResource BrushTextPrimary}">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                                    Width="15" Height="15"
                                                    Foreground="{StaticResource BrushAccentBright}"
                                                    VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Question}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                   Margin="9,0,0,0" TextWrapping="Wrap" MaxWidth="440" />
                      </StackPanel>
                    </Expander.Header>
                    <TextBlock Text="{Binding Answer}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="24,4,0,8" LineHeight="18" />
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Row="3" Text="{Binding ExportStatusText}" Style="{StaticResource Caption}"
                     Margin="0,10,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
