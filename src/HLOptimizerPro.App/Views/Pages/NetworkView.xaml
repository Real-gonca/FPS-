<!--
  ============================================================================
  Ferramenta Rede (3.4-b)
  ============================================================================
  Estado da ligação (adaptador, IPv4, gateway, DNS, velocidade, IP público, operadora),
  latências medidas ao gateway e à Internet, benchmark DNS real aos 5 fornecedores,
  recomendação, aplicar DNS / voltar ao automático e as manutenções de rede.
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{StaticResource PageTransition}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel>

      <!-- ===================== ESTADO DA LIGAÇÃO ===================== -->
      <Border Style="{StaticResource Card}" Padding="20,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                       Fill="{Binding ConnectionHealth, Converter={StaticResource HealthToBrush}}" />
              <TextBlock Text="{Binding ConnectionStateText}" Style="{StaticResource H2}" FontSize="19"
                         Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding AdapterNameText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Latência ao gateway" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding GatewayLatencyText}" Style="{StaticResource MetricValueSmall}"
                       HorizontalAlignment="Right" Margin="0,4,0,10" />
            <TextBlock Text="Latência à Internet" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding InternetLatencyText}" Style="{StaticResource MetricValueSmall}"
                       HorizontalAlignment="Right" Margin="0,4,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
            <Button Style="{StaticResource ButtonPrimary}"
                    Content="Testar Novamente"
                    Height="42"
                    MinWidth="160"
                    Command="{Binding AnalyzeCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <Button Style="{StaticResource ButtonGhost}"
                    Content="Repetir benchmark DNS"
                    Margin="0,6,0,0"
                    Command="{Binding BenchmarkCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===================== DETALHES DO ADAPTADOR ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
        <StackPanel>
          <TextBlock Text="Adaptador de rede" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />

          <UniformGrid Columns="4" Rows="2">
            <StackPanel Margin="0,0,16,14">
              <TextBlock Text="IPv4" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding Ipv4Text}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,16,14">
              <TextBlock Text="Máscara de sub-rede" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding SubnetText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,16,14">
              <TextBlock Text="Gateway predefinido" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding GatewayText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,16,14">
              <TextBlock Text="Velocidade do adaptador" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Servidores DNS em uso" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding CurrentDnsServersText}" Style="{StaticResource Mono}" Margin="0,3,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Endereço MAC" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding MacText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="IP público" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding PublicIpText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Operadora / Rede" Style="{StaticResource Caption}" />
              <TextBlock Text="{Binding IspText}" Style="{StaticResource Body}" Margin="0,3,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- ===================== BENCHMARK DNS ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="Dns" Width="17" Height="17"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Benchmark de servidores DNS" Style="{StaticResource H3}" Margin="9,0,0,0" />
              <TextBlock Text="(5 consultas reais por servidor, porta 53)"
                         Style="{StaticResource Caption}" Margin="8,3,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource ButtonSmallSecondary}"
                      Content="Voltar ao automático"
                      Margin="0,0,8,0"
                      Command="{Binding RestoreDhcpDnsCommand}" />
              <Button Style="{StaticResource ButtonSmall}"
                      Content="Aplicar recomendado"
                      IsEnabled="{Binding HasRecommendation}"
                      Command="{Binding ApplyDnsCommand}" />
            </StackPanel>
          </Grid>

          <!-- Recomendação -->
          <Border Style="{StaticResource CardCompact}" Margin="0,14,0,0"
                  Background="{Binding RecommendationLevel, Converter={StaticResource HealthToSoftBrush}}"
                  BorderBrush="{Binding RecommendationLevel, Converter={StaticResource HealthToBrush}}"
                  Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="LightbulbOnOutline" Width="16" Height="16"
                                          Foreground="{Binding RecommendationLevel, Converter={StaticResource HealthToBrush}}"
                                          VerticalAlignment="Top" />
              <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource Body}"
                         Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="760" />
            </StackPanel>
          </Border>

          <!-- Tabela de resultados -->
          <Grid Margin="0,16,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.3*" />
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="0.8*" />
              <ColumnDefinition Width="1.4*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Servidor" Style="{StaticResource SectionLabel}" />
            <TextBlock Grid.Column="1" Text="Endereços" Style="{StaticResource SectionLabel}" />
            <TextBlock Grid.Column="2" Text="Média" Style="{StaticResource SectionLabel}" />
            <TextBlock Grid.Column="3" Text="Jitter" Style="{StaticResource SectionLabel}" />
            <TextBlock Grid.Column="4" Text="Perda" Style="{StaticResource SectionLabel}" />
            <TextBlock Grid.Column="5" Text="Pontos" Style="{StaticResource SectionLabel}" />
            <TextBlock Grid.Column="6" Text="Avaliação" Style="{StaticResource SectionLabel}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding DnsResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource BrushBgSunken}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.3*" />
                      <ColumnDefinition Width="1.5*" />
                      <ColumnDefinition Width="1*" />
                      <ColumnDefinition Width="1*" />
                      <ColumnDefinition Width="1*" />
                      <ColumnDefinition Width="0.8*" />
                      <ColumnDefinition Width="1.4*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                               Fill="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                 Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding ServersText}" Style="{StaticResource Mono}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding AverageText}" Style="{StaticResource Mono}"
                               FontSize="11.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding JitterText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding LossText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding ScoreText}" Style="{StaticResource Mono}"
                               FontSize="11.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding StatusText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />

                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Style="{StaticResource Badge}" Margin="0,0,8,0"
                              Background="{Binding Health, Converter={StaticResource HealthToSoftBrush}}"
                              BorderBrush="{Binding Health, Converter={StaticResource HealthToBrush}}"
                              Visibility="{Binding IsBest, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding BestText}" Style="{StaticResource BadgeText}"
                                   Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                      </Border>
                      <Button Style="{StaticResource ButtonSmallSecondary}"
                              Content="Usar este"
                              Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Se ainda não testou, use «Testar Novamente». O tempo da primeira consulta a cada servidor inclui o estabelecimento de ligação, por isso a média é calculada sobre as restantes consultas."
                     Style="{StaticResource Caption}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- ===================== MANUTENÇÃO DE REDE ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
        <StackPanel>
          <TextBlock Text="Manutenção da rede" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />

          <UniformGrid Columns="4">
            <Button Style="{StaticResource ButtonSecondary}"
                    Margin="0,0,10,0"
                    Content="Limpar cache DNS"
                    Command="{Binding FlushDnsCommand}" />
            <Button Style="{StaticResource ButtonSecondary}"
                    Margin="0,0,10,0"
                    Content="Renovar IP"
                    Command="{Binding RenewIpCommand}" />
            <Button Style="{StaticResource ButtonSecondary}"
                    Margin="0,0,10,0"
                    Content="Otimizar TCP (latência)"
                    Command="{Binding OptimizeTcpCommand}" />
            <Button Style="{StaticResource ButtonSecondary}"
                    Content="Repor pilha de rede"
                    Command="{Binding ResetNetworkStackCommand}" />
          </UniformGrid>

          <TextBlock Text="A limpeza da cache DNS resolve endereços desatualizados; a renovação de IP é útil depois de mudar de rede; a otimização de TCP desliga o algoritmo de Nagle e o throttling, reduzindo a latência em jogos (pode reduzir a velocidade máxima de transferência em redes instáveis)."
                     Style="{StaticResource Caption}"
                     Margin="0,12,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
