<!--
  ============================================================================
  Ferramenta Modo Jogo (3.4-e)
  ============================================================================
  Explicação do que faz, comutador de ativação, estado em tempo real (jogo detetado, PID,
  processos de fundo limitados), biblioteca com pesquisa, adição de jogos personalizados
  e ativação manual / reposição imediata.
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{StaticResource PageTransition}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== ESTADO + COMUTADOR ===================== -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{Binding StateHealth, Converter={StaticResource HealthToBrush}}" />
            <TextBlock Text="{Binding StateText}" Style="{StaticResource H2}" FontSize="19" Margin="10,0,0,0" />
          </StackPanel>

          <TextBlock Text="{Binding LastMessage}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                     TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" />

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Border Style="{StaticResource Badge}">
              <TextBlock Text="{Binding ActiveGameText}" Style="{StaticResource BadgeText}" />
            </Border>
            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
              <TextBlock Text="{Binding ThrottledText}" Style="{StaticResource BadgeText}" />
            </Border>
            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
              <TextBlock Text="{Binding MemoryText}" Style="{StaticResource BadgeText}" />
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
          <CheckBox Style="{StaticResource ToggleSwitch}"
                    Content="Modo Jogo ativo"
                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                    Command="{Binding ToggleEnabledCommand}"
                    HorizontalAlignment="Right" />
          <TextBlock Text="A deteção automática verifica os jogos a cada 3 segundos."
                     Style="{StaticResource Caption}"
                     Margin="0,10,0,0" MaxWidth="220" TextWrapping="Wrap"
                     HorizontalAlignment="Right" TextAlignment="Right" />
          <Button Style="{StaticResource ButtonGhost}"
                  Content="Repor tudo agora"
                  Margin="0,8,0,0"
                  HorizontalAlignment="Right"
                  Command="{Binding DeactivateCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== CONTEÚDO ===================== -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.35*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Biblioteca -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="LibraryShelves" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Biblioteca de jogos" Style="{StaticResource H3}" Margin="9,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource ButtonSmallSecondary}" Content="Atualizar"
                      Margin="0,0,6,0" Command="{Binding RefreshLibraryCommand}" />
              <Button Style="{StaticResource ButtonSmall}" Content="Adicionar Jogo"
                      Command="{Binding AddCustomGameCommand}" />
            </StackPanel>
          </Grid>

          <TextBox Grid.Row="1"
                   Margin="0,12,0,10"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Pesquisar por nome ou processo (ex.: valorant, cs2, roblox)" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding FilteredLibrary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource BrushBgSunken}"
                          BorderBrush="{StaticResource BrushBorderSubtle}"
                          BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                              Background="{StaticResource BrushAccentSubtle}"
                              BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1"
                              VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="{Binding IconGlyph, Converter={StaticResource IconKind}}"
                                                    Width="18" Height="18"
                                                    Foreground="{StaticResource BrushAccentBright}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                          <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                  Background="{Binding StateHealth, Converter={StaticResource HealthToSoftBrush}}"
                                  BorderBrush="{Binding StateHealth, Converter={StaticResource HealthToBrush}}">
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}"
                                       Foreground="{Binding StateHealth, Converter={StaticResource HealthToBrush}}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ProcessNamesText, StringFormat={}Processos: {0}}"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource BrushSuccess}" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource ButtonSmallSecondary}"
                                Content="Ativar agora"
                                Command="{Binding DataContext.ActivateForCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource ButtonGhost}"
                                Content="Remover"
                                Margin="0,4,0,0"
                                Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.RemoveCustomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Explicação -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16"
                                        Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
            <TextBlock Text="O que o Modo Jogo faz" Style="{StaticResource H3}" Margin="9,0,0,0" />
          </StackPanel>

          <TextBlock Text="Quando um jogo da biblioteca é detetado, o HL Optimizer Pro ajusta automaticamente o sistema para jogar — e repõe tudo quando o jogo fecha. Não é magia: são ajustes medíveis e reversíveis."
                     Style="{StaticResource Secondary}"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />

          <ItemsControl ItemsSource="{Binding Features}" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="14" Height="14"
                                              Foreground="{StaticResource BrushSuccess}"
                                              VerticalAlignment="Top" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="9,0,0,0"
                             TextWrapping="Wrap" MaxWidth="300" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource CardCompact}" Margin="0,14,0,0"
                  Background="{StaticResource BrushAccentSubtle}"
                  BorderBrush="{StaticResource BrushGlassBorder}">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="ShieldCheckOutline" Width="15" Height="15"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Top" />
              <TextBlock Text="Os processos críticos do Windows nunca são limitados ou encerrados — a lista de proteção é aplicada antes de qualquer alteração."
                         Style="{StaticResource Caption}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
            </StackPanel>
          </Border>

          <TextBlock Text="A deteção usa o nome do processo (ex.: «valorant.exe»). Se um jogo não for detetado, use «Adicionar Jogo» e escolha o executável principal."
                     Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
