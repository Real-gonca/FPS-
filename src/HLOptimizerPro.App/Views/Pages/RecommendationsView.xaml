<!--
  ============================================================================
  Recomendações (3.7)
  ============================================================================
  Grupos por prioridade (alta / média / baixa) com o botão «Aplicar» em cada recomendação e
  «Aplicar todas» por grupo. A fonte é o último relatório de avaliação (com cache de 30 minutos).
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.RecommendationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{StaticResource PageTransition}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== CABEÇALHO ===================== -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Recomendações para o seu computador" Style="{StaticResource H2}" FontSize="19" />
          <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                     TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Style="{StaticResource ButtonPrimary}"
                  Content="Recalcular recomendações"
                  MinWidth="200"
                  Height="40"
                  Command="{Binding LoadCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}"
                     Margin="0,8,0,0" TextAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== GRUPOS ===================== -->
    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
              <StackPanel>
                <!-- Cabeçalho do grupo -->
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{Binding Priority, Converter={StaticResource PriorityToBrush}, ConverterParameter=soft}"
                            BorderBrush="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                            BorderThickness="1">
                      <iconPacks:PackIconMaterial Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                                  Width="17" Height="17"
                                                  Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                          <TextBlock Text="{Binding Summary}" Style="{StaticResource BadgeText}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonSecondary}"
                            Content="Aplicar todas deste grupo"
                            Command="{Binding DataContext.ApplyGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource ButtonGhost}"
                            Content="Mostrar/Ocultar"
                            Margin="8,0,0,0"
                            Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>

                <!-- Itens -->
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,14,0,0"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource BrushBgSunken}"
                              BorderBrush="{StaticResource BrushBorderSubtle}"
                              BorderThickness="1" CornerRadius="10"
                              Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <iconPacks:PackIconMaterial Grid.Column="0"
                                                      Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                                      Width="18" Height="18"
                                                      Foreground="{StaticResource BrushAccentBright}"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />

                          <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                              <Border Style="{StaticResource Badge}" Margin="10,0,0,0"
                                      Background="{Binding Priority, Converter={StaticResource PriorityToBrush}}">
                                <TextBlock Text="{Binding PriorityText}" Style="{StaticResource BadgeText}"
                                           Foreground="{StaticResource BrushTextOnAccent}" />
                              </Border>
                              <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                      Background="{StaticResource BrushSuccessSoft}"
                                      BorderBrush="{StaticResource BrushSuccess}"
                                      Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Aplicada" Style="{StaticResource BadgeText}"
                                           Foreground="{StaticResource BrushSuccess}" />
                              </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding ExpectedBenefit, StringFormat={}Benefício esperado: {0}}"
                                       Style="{StaticResource Caption}"
                                       Foreground="{StaticResource BrushSuccess}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                          <Button Grid.Column="2"
                                  Style="{StaticResource ButtonSmall}"
                                  Content="Aplicar"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsApplied, Converter={StaticResource InverseBool}}"
                                  Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
