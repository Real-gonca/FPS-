<!--
  ============================================================================
  Sobre / Premium (3.10)
  ============================================================================
  Versão, stack técnica, estado da licença com ativação por chave, recursos Premium,
  informações do computador para suporte, termos de utilização e política de privacidade.
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{StaticResource PageTransition}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel>

      <!-- ===================== IDENTIDADE ===================== -->
      <Border Style="{StaticResource Card}" Padding="22,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Image Grid.Column="0" Source="{StaticResource LogoImage}" Width="96" Height="96"
                 VerticalAlignment="Top" />

          <StackPanel Grid.Column="1" Margin="20,0,20,0">
            <TextBlock Text="{Binding ProductName}" Style="{StaticResource H1}" FontSize="26" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource H3}"
                       Foreground="{StaticResource BrushAccentBright}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Slogan}" Style="{StaticResource Secondary}" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Publisher, StringFormat={}Publicado por {0}}" Style="{StaticResource Caption}"
                       Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                <TextBlock Text=".NET 8" Style="{StaticResource BadgeText}" />
              </Border>
              <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                <TextBlock Text="C# WPF" Style="{StaticResource BadgeText}" />
              </Border>
              <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                <TextBlock Text="MVVM" Style="{StaticResource BadgeText}" />
              </Border>
              <Border Style="{StaticResource Badge}">
                <TextBlock Text="Windows 10/11 x64" Style="{StaticResource BadgeText}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <Border HorizontalAlignment="Right">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                  <Setter Property="Background" Value="{StaticResource BrushBgSunken}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPremium}" Value="True">
                      <Setter Property="Background" Value="{StaticResource BrushSuccessSoft}" />
                      <Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="StarFourPoints" Width="13" Height="13"
                                            Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LicenseStateText}" Style="{StaticResource BadgeText}" Margin="6,0,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding LicenseExpiryText}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" Margin="0,6,0,0" />
            <TextBlock Text="{Binding AccountText}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===================== LICENÇA ===================== -->
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="KeyOutline" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Licença" Style="{StaticResource H3}" Margin="9,0,0,0" />
            </StackPanel>

            <TextBlock Text="Introduza a sua chave Premium. A validação é feita localmente (assinatura HMAC) e a licença continua válida até 30 dias sem Internet."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />

            <TextBlock Text="Chave de licença" Style="{StaticResource Caption}" Margin="0,14,0,5" />
            <TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Licenciado a" Style="{StaticResource Caption}" Margin="0,12,0,5" />
            <TextBox Text="{Binding LicensedTo, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Style="{StaticResource ButtonPrimary}" Content="Ativar licença"
                      Margin="0,0,8,0" Command="{Binding ActivateLicenseCommand}" />
              <Button Style="{StaticResource ButtonSecondary}" Content="Validar novamente"
                      Margin="0,0,8,0" Command="{Binding RevalidateLicenseCommand}" />
              <Button Style="{StaticResource ButtonGhost}" Content="Desativar"
                      Command="{Binding DeactivateLicenseCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding ActivationMessage}" Style="{StaticResource Caption}"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ActivationHint}" Style="{StaticResource Caption}"
                       Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- Recursos Premium -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="CrownOutline" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Recursos do plano Premium" Style="{StaticResource H3}" Margin="9,0,0,0" />
            </StackPanel>

            <TextBlock Text="O plano Free já otimiza o essencial. O Premium acrescenta:"
                       Style="{StaticResource Caption}" Margin="0,10,0,0" />

            <ItemsControl ItemsSource="{Binding PremiumFeatures}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="14" Height="14"
                                                Foreground="{StaticResource BrushSuccess}"
                                                VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Margin="9,0,0,0">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                 TextWrapping="Wrap" MaxWidth="420"
                                 Visibility="{Binding Description, Converter={StaticResource EmptyStringToVisibility}}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===================== STACK TÉCNICA ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="CodeBraces" Width="16" Height="16"
                                        Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
            <TextBlock Text="Como foi construída" Style="{StaticResource H3}" Margin="9,0,0,0" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Stack}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardCompact}" Margin="0,0,10,10">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Body}" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===================== SUPORTE + LEGAL ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Suporte e informação legal" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="{Binding SupportEmail, StringFormat={}Suporte: {0} — resposta em dias úteis. Inclua o ficheiro de diagnóstico (Ajuda → Exportar diagnóstico) para acelerarmos a análise.}"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="700"
                       HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Style="{StaticResource ButtonSmallSecondary}" Content="Termos de Utilização"
                      Margin="0,0,8,0" Command="{Binding ShowTermsCommand}" />
              <Button Style="{StaticResource ButtonSmallSecondary}" Content="Política de Privacidade"
                      Margin="0,0,8,0" Command="{Binding ShowPrivacyCommand}" />
              <Button Style="{StaticResource ButtonSmallSecondary}" Content="Copiar informação do sistema"
                      Command="{Binding CopyMachineInfoCommand}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
            <Button Style="{StaticResource ButtonPrimary}" Content="Contactar suporte"
                    Command="{Binding OpenSupportEmailCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
