<!--
  ============================================================================
  PC Boost (3.6)
  ============================================================================
  Hardware detetado, pergunta Gamer ou Empresarial, plano explicado ("Vamos otimizar do jeito
  certo!"), apps e jogos populares com ícones e estado real, aplicar e reverter.
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.PcBoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{StaticResource PageTransition}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== HARDWARE + PERGUNTA ===================== -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Vamos otimizar do jeito certo!" Style="{StaticResource H1}" FontSize="24" />
          <TextBlock Text="Hardware detetado neste computador" Style="{StaticResource SectionLabel}"
                     Margin="0,10,0,6" />
          <TextBlock Text="{Binding HardwareSummary}" Style="{StaticResource Secondary}"
                     TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding HardwareDetails}" Style="{StaticResource Mono}" FontSize="11"
                     Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Para que usa este computador?" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />

          <RadioButton x:Name="GamerOption" GroupName="Usage"
                       IsChecked="{Binding IsGamer, Mode=TwoWay}"
                       Margin="0,0,0,8" Cursor="Hand">
            <RadioButton.Template>
              <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Root" CornerRadius="12" Padding="14,12" MinWidth="240"
                        Background="{StaticResource BrushBgSunken}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ControllerClassic" Width="20" Height="20"
                                                Foreground="{StaticResource BrushAccentBright}"
                                                VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                      <TextBlock Text="Gamer" FontWeight="SemiBold" />
                      <TextBlock Text="Prioridade ao jogo, latência baixa, menos trabalho em segundo plano"
                                 Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="240" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGlassBorderStrong}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </RadioButton.Template>
          </RadioButton>

          <RadioButton GroupName="Usage"
                       IsChecked="{Binding IsBusiness, Mode=TwoWay}"
                       Cursor="Hand">
            <RadioButton.Template>
              <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Root" CornerRadius="12" Padding="14,12" MinWidth="240"
                        Background="{StaticResource BrushBgSunken}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="BriefcaseOutline" Width="20" Height="20"
                                                Foreground="{StaticResource BrushAccentBright}"
                                                VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0">
                      <TextBlock Text="Empresarial" FontWeight="SemiBold" />
                      <TextBlock Text="Arranque rápido, interface responsiva, privacidade e estabilidade"
                                 Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="240" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGlassBorderStrong}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </RadioButton.Template>
          </RadioButton>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
          <Button Style="{StaticResource ButtonPrimary}"
                  MinWidth="190"
                  Height="46"
                  Content="Aplicar este plano"
                  IsEnabled="{Binding HasPlan}"
                  Command="{Binding ApplyPlanCommand}" />
          <Button Style="{StaticResource ButtonSecondary}"
                  Content="Reverter tudo"
                  Margin="0,8,0,0"
                  Command="{Binding RevertPlanCommand}" />
          <Button Style="{StaticResource ButtonGhost}"
                  Content="Detetar aplicações novamente"
                  Margin="0,4,0,0"
                  Command="{Binding DetectAgainCommand}" />
          <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Caption}"
                     Margin="0,8,0,0" MaxWidth="200" TextWrapping="Wrap" TextAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== PLANO + APPS ===================== -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1.2*" />
      </Grid.ColumnDefinitions>

      <!-- Plano -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="ClipboardCheckOutline" Width="16" Height="16"
                                        Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
            <TextBlock Text="O plano" Style="{StaticResource H3}" Margin="9,0,0,0" />
          </StackPanel>

          <TextBlock Text="{Binding PlanDescription}" Style="{StaticResource Body}"
                     TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                     TextWrapping="Wrap" />
          <Border Style="{StaticResource CardCompact}" Margin="0,12,0,0"
                  Background="{StaticResource BrushAccentSubtle}"
                  BorderBrush="{StaticResource BrushGlassBorder}">
            <TextBlock Text="{Binding ImpactText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
          </Border>

          <TextBlock Text="Porque estas escolhas" Style="{StaticResource SectionLabel}" Margin="0,16,0,8" />
          <ItemsControl ItemsSource="{Binding PlanReasons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="13" Height="13"
                                              Foreground="{StaticResource BrushSuccess}"
                                              VerticalAlignment="Top" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="9,0,0,0"
                             TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Apps e jogos populares -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="Apps" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Aplicações e jogos populares" Style="{StaticResource H3}" Margin="9,0,0,0" />
            </StackPanel>
            <TextBlock Text="As que estão detetadas ficam selecionadas: o plano inclui a otimização individual de cada uma (prioridade, afinidade e energia)."
                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Targets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource BrushBgSunken}"
                          BorderBrush="{StaticResource BrushBorderSubtle}"
                          BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                              Background="{StaticResource BrushAccentSubtle}"
                              BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1">
                        <iconPacks:PackIconMaterial Kind="{Binding IconGlyph, Converter={StaticResource IconKind}}"
                                                    Width="18" Height="18"
                                                    Foreground="{StaticResource BrushAccentBright}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                          <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                  Background="{Binding StateHealth, Converter={StaticResource HealthToSoftBrush}}"
                                  BorderBrush="{Binding StateHealth, Converter={StaticResource HealthToBrush}}">
                            <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}"
                                       Foreground="{Binding StateHealth, Converter={StaticResource HealthToBrush}}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource BrushSuccess}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding IsInstalled}"
                                ToolTip="Incluir no plano" />

                      <Border Grid.Column="3" Style="{StaticResource Badge}" VerticalAlignment="Center"
                              Background="{StaticResource BrushInfoSoft}"
                              BorderBrush="{StaticResource BrushInfo}"
                              Visibility="{Binding IsGame, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Jogo" Style="{StaticResource BadgeText}"
                                   Foreground="{StaticResource BrushInfo}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
