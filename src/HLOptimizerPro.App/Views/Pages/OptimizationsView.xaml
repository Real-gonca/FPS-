<!--
  ============================================================================
  Otimizações do Windows (3.5)
  ============================================================================
  Separadores Windows / Sistema / Privacidade / Unidade de Disco / Windows Update / Toque /
  Aplicativos. Cada ajuste apresenta descrição, alvo, valor atual → novo, risco, se requer reinício
  e se é reversível. Inclui a limpeza automática (ligar/desligar, intervalo em dias e alvos).
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.OptimizationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Style="{StaticResource PageTransition}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===================== CABEÇALHO ===================== -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Otimizações do Windows" Style="{StaticResource H2}" FontSize="19" />
          <TextBlock Text="{Binding CoverageText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Style="{StaticResource ToggleSwitch}" Content="Só pendentes"
                    IsChecked="{Binding OnlyPending}" Margin="0,0,14,0" VerticalAlignment="Center" />
          <Button Style="{StaticResource ButtonGhost}" Content="Atualizar"
                  Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource ButtonSecondary}" Content="Exportar diário"
                  Command="{Binding ExportJournalCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource ButtonSecondary}" Content="Reverter tudo"
                  Command="{Binding RevertAllCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource ButtonPrimary}" Content="Aplicar Otimizações"
                  Command="{Binding ApplyAllCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== SEPARADORES ===================== -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="10,8">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="OptimizationTabs"
                         Margin="4,2"
                         Padding="14,9"
                         Cursor="Hand"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         CommandParameter="{Binding}">
              <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Root" CornerRadius="10" Padding="{TemplateBinding Padding}"
                          Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushAccentSubtle}" />
                      <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                    </Trigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsChecked" Value="False" />
                      </MultiTrigger.Conditions>
                      <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                    </MultiTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </RadioButton.Template>

              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                            Width="15" Height="15" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="6,0">
                  <TextBlock Style="{StaticResource BadgeText}"
                             Text="{Binding AppliedCount, StringFormat={}{0}}" />
                </Border>
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ===================== LISTA DE AJUSTES ===================== -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <ItemsControl ItemsSource="{Binding VisibleActions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                      <Border Style="{StaticResource Badge}" Margin="10,0,0,0"
                              Background="{Binding RiskLevel, Converter={StaticResource HealthToSoftBrush}}"
                              BorderBrush="{Binding RiskLevel, Converter={StaticResource HealthToBrush}}">
                        <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource BadgeText}"
                                   Foreground="{Binding RiskLevel, Converter={StaticResource HealthToBrush}}" />
                      </Border>
                      <Border Style="{StaticResource Badge}" Margin="6,0,0,0">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}" />
                      </Border>
                      <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                              Background="{StaticResource BrushInfoSoft}"
                              BorderBrush="{StaticResource BrushInfo}"
                              ToolTip="Se requer reinício">
                        <TextBlock Text="{Binding RestartText}" Style="{StaticResource BadgeText}"
                                   Foreground="{StaticResource BrushInfo}" />
                      </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,7,0,0"
                               TextWrapping="Wrap" />

                    <Border Style="{StaticResource CardCompact}" Margin="0,9,0,0" Padding="10,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Target, StringFormat={}Alvo: {0}}"
                                   Style="{StaticResource Mono}" FontSize="10.5"
                                   Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                          <TextBlock Text="{Binding CurrentValue, StringFormat={}Agora: {0}}"
                                     Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="330" />
                          <iconPacks:PackIconMaterial Kind="ArrowRight" Width="13" Height="13"
                                                      Margin="8,2,8,0"
                                                      Foreground="{StaticResource BrushAccentBright}"
                                                      VerticalAlignment="Center" />
                          <TextBlock Text="{Binding NewValue, StringFormat={}Depois: {0}}"
                                     Style="{StaticResource Caption}"
                                     Foreground="{StaticResource BrushSuccess}"
                                     TextWrapping="Wrap" MaxWidth="330" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Risk, StringFormat={}Risco: {0}}"
                               Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button Style="{StaticResource ButtonSmall}"
                            Content="Aplicar"
                            Command="{Binding DataContext.ApplySingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource ButtonSmallSecondary}"
                            Content="Simular"
                            Margin="0,6,0,0"
                            ToolTip="Mostra exatamente o que seria alterado, sem tocar no sistema"
                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- ===================== LIMPEZA AUTOMÁTICA ===================== -->
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconMaterial Kind="Broom" Width="16" Height="16"
                                        Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
            <TextBlock Text="Limpeza automática" Style="{StaticResource H3}" Margin="9,0,0,0" />
          </StackPanel>

          <CheckBox Style="{StaticResource ToggleSwitchWithLabel}"
                    Content="Executar limpeza automaticamente"
                    Margin="0,14,0,0"
                    IsChecked="{Binding AutoCleanupEnabled}" />

          <TextBlock Text="Intervalo entre limpezas" Style="{StaticResource Caption}" Margin="0,14,0,5" />
          <ComboBox ItemsSource="{Binding IntervalOptions}"
                    SelectedItem="{Binding AutoCleanupIntervalDays, Mode=TwoWay}"
                    ToolTip="Por omissão: a cada 7 dias" />

          <TextBlock Text="O que limpar" Style="{StaticResource Caption}" Margin="0,14,0,6" />
          <ItemsControl ItemsSource="{Binding CleanupTargets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="0,3"
                          Content="{Binding Name}"
                          IsChecked="{Binding IsSelected}"
                          ToolTip="{Binding Description}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Style="{StaticResource ButtonSecondary}" Content="Configurar"
                    Command="{Binding ConfigureAutoCleanupCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource ButtonSmallSecondary}" Content="Limpar agora"
                    Command="{Binding RunAutoCleanupNowCommand}" />
          </StackPanel>

          <Border Style="{StaticResource CardCompact}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="{Binding AutoCleanupDescription}" Style="{StaticResource Caption}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding AutoCleanupNextRun}" Style="{StaticResource Caption}"
                         Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock Text="A limpeza automática nunca toca em Documentos, Transferências ou Ambiente de Trabalho — só ficheiros temporários e caches reconstruíveis."
                     Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== NOTA ===================== -->
    <Border Grid.Row="3" Style="{StaticResource CardCompact}" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <iconPacks:PackIconMaterial Kind="History" Width="15" Height="15"
                                    Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Top" />
        <TextBlock Text="Todas as alterações ficam no diário (ficheiro JSON + exportação CSV) com o valor original, a data e o motivo. Pode reverter individualmente ou tudo de uma vez — sem reinstalar nada."
                   Style="{StaticResource Caption}" Margin="10,0,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
