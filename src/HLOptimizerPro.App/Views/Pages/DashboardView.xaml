<!--
  ============================================================================
  Dashboard (3.2)
  ============================================================================
  · Saudação + resumo real de hardware
  · Estado do sistema, otimizações pendentes e última atualização das métricas
  · Botão grande "Executar Otimização"
  · Três gauges circulares (CPU / RAM / GPU) + cartão de Uptime
  · Gráfico "Desempenho do Sistema" das últimas 24 h (OxyPlot, dados reais)
  · Atalhos Rápidos: Limpeza Rápida / Modo Jogo / Restaurar Ponto / Logs
-->
<UserControl x:Class="HLOptimizerPro.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:HLOptimizerPro.App.Controls"
             xmlns:oxy="http://oxyplot.org/wpf"
             Style="{StaticResource PageTransition}"
             d:DesignHeight="800" d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel>

      <!-- ===================== CABEÇALHO: SAUDAÇÃO + AÇÃO PRINCIPAL ===================== -->
      <Border Style="{StaticResource Card}" Padding="22,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" FontSize="24" />
            <TextBlock Text="{Binding MachineSummary}"
                       Style="{StaticResource Secondary}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       MaxWidth="620"
                       HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Border Style="{StaticResource Badge}"
                      Background="{Binding Shell.SystemState, Converter={StaticResource HealthToSoftBrush}}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                           Fill="{Binding Shell.SystemState, Converter={StaticResource HealthToBrush}}" />
                  <TextBlock Text="{Binding Shell.SystemStateText}"
                             Style="{StaticResource BadgeText}" Margin="7,0,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                <TextBlock Text="{Binding PendingText}" Style="{StaticResource BadgeText}" />
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding LastUpdateText}"
                       Style="{StaticResource Caption}"
                       Margin="0,10,0,0" />
          </StackPanel>

          <!-- Botão grande de otimização -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
            <Button Style="{StaticResource ButtonPrimary}"
                    Height="56"
                    MinWidth="260"
                    Command="{Binding RunOptimizationCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="RocketLaunch" Width="20" Height="20" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0">
                  <TextBlock Text="Executar Otimização" FontSize="14.5" FontWeight="SemiBold" />
                  <TextBlock Text="Limpeza + otimizações recomendadas"
                             FontSize="11"
                             Opacity="0.85"
                             Margin="0,1,0,0" />
                </StackPanel>
              </StackPanel>
            </Button>
            <TextBlock Text="Um ponto de restauro e o backup das chaves são criados antes de alterar o sistema."
                       Style="{StaticResource Caption}"
                       Margin="0,8,0,0"
                       MaxWidth="260"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===================== GAUGES + UPTIME ===================== -->
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <!-- CPU -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
          <StackPanel>
            <controls:GaugeControl Value="{Binding CpuPercent}"
                                   ValueText="{Binding CpuValueText}"
                                   SubText="{Binding CpuSubText}"
                                   Title="CPU"
                                   AccentBrush="{StaticResource BrushGaugeCpu}"
                                   Height="164" />
          </StackPanel>
        </Border>

        <!-- RAM -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
          <StackPanel>
            <controls:GaugeControl Value="{Binding RamPercent}"
                                   ValueText="{Binding RamValueText}"
                                   SubText="{Binding RamSubText}"
                                   Title="Memória RAM"
                                   AccentBrush="{StaticResource BrushGaugeRam}"
                                   Height="164" />
            <Border Style="{StaticResource Badge}"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Background="{StaticResource BrushWarningSoft}"
                    BorderBrush="{StaticResource BrushWarning}"
                    Visibility="{Binding RamLowWarning, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Menos de 20 % livre — use a Limpeza de Memória"
                         Style="{StaticResource BadgeText}"
                         Foreground="{StaticResource BrushWarning}" />
            </Border>
          </StackPanel>
        </Border>

        <!-- GPU -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
          <StackPanel>
            <controls:GaugeControl Value="{Binding GpuPercent}"
                                   ValueText="{Binding GpuValueText}"
                                   SubText="{Binding GpuSubText}"
                                   Title="GPU"
                                   AccentBrush="{StaticResource BrushGaugeGpu}"
                                   Height="164" />
          </StackPanel>
        </Border>

        <!-- Cartões de estado do sistema -->
        <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Estado do sistema" Style="{StaticResource SectionLabel}" />

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconMaterial Kind="ClockTimeFourOutline" Width="15" Height="15"
                                              Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
                  <TextBlock Text="Tempo ligado (Uptime)" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource MetricValueSmall}"
                           HorizontalAlignment="Right" />
              </Grid>

              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconMaterial Kind="Thermometer" Width="15" Height="15"
                                              Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
                  <TextBlock Text="Temperatura" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource MetricValueSmall}"
                           HorizontalAlignment="Right" />
              </Grid>

              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconMaterial Kind="Harddisk" Width="15" Height="15"
                                              Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
                  <TextBlock Text="Disco do sistema" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding DiskText}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" MaxWidth="150" TextTrimming="CharacterEllipsis" />
              </Grid>

              <Grid>
                <StackPanel Orientation="Horizontal">
                  <iconPacks:PackIconMaterial Kind="Apps" Width="15" Height="15"
                                              Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
                  <TextBlock Text="Processos" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding ProcessCountText}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" MaxWidth="150" TextTrimming="CharacterEllipsis" />
              </Grid>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Badge}" Margin="0,12,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding RamLowWarning, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Sugestão: liberte memória antes de abrir jogos" Style="{StaticResource BadgeText}" />
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ===================== GRÁFICO 24 H ===================== -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="260" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="ChartTimelineVariant" Width="16" Height="16"
                                          Foreground="{StaticResource BrushAccentBright}" VerticalAlignment="Center" />
              <TextBlock Text="Desempenho do Sistema" Style="{StaticResource H3}" Margin="9,0,0,0" VerticalAlignment="Center" />
              <TextBlock Text="(últimas 24 horas, uma amostra por minuto)"
                         Style="{StaticResource Caption}" Margin="8,2,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Dados medidos neste computador"
                       Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="1">
            <oxy:PlotView Model="{Binding PerformanceChart}"
                          Background="Transparent"
                          Visibility="{Binding ChartHasData, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource CardCompact}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="520"
                    Visibility="{Binding ChartHasData, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverter}">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="ClockOutline" Width="18" Height="18"
                                            Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding ChartEmptyMessage}"
                           Style="{StaticResource Secondary}"
                           Margin="12,0,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="440" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- ===================== ATALHOS RÁPIDOS ===================== -->
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1.05*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,16">
          <StackPanel>
            <TextBlock Text="Atalhos Rápidos" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding QuickActions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="4"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          FocusVisualStyle="{x:Null}"
                          Cursor="Hand"
                          Command="{Binding DataContext.RunQuickActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding Key}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Style="{StaticResource CardInteractive}" Padding="12,14">
                          <ContentPresenter />
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                      <Border Width="38" Height="38" CornerRadius="11"
                              HorizontalAlignment="Left"
                              Background="{StaticResource BrushAccentSubtle}"
                              BorderBrush="{StaticResource BrushGlassBorder}"
                              BorderThickness="1">
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind, Converter={StaticResource IconKind}}"
                                                    Width="19" Height="19"
                                                    Foreground="{StaticResource BrushAccentBright}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Cartão de segurança / ponto de restauro -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="ShieldCheckOutline" Width="16" Height="16"
                                          Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
              <TextBlock Text="Segurança antes de tudo" Style="{StaticResource SectionLabel}" Margin="9,0,0,0" />
            </StackPanel>

            <TextBlock Text="Todas as alterações guardam o valor original e podem ser revertidas em «Otimizações → A restaurar»."
                       Style="{StaticResource Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <Border Style="{StaticResource CardCompact}" Margin="0,12,0,0">
              <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </Border>

            <Button Style="{StaticResource ButtonSecondary}"
                    Margin="0,12,0,0"
                    Content="Verificar pontos de restauro"
                    Command="{Binding CheckRestorePointsCommand}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
