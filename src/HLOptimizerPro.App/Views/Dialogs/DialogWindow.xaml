<!--
  Janela de diálogo da aplicação (confirmação, informação e pré-visualização do modo Simular).
  Substitui as MessageBox do sistema para manter a identidade visual (tema escuro + vidro).
-->
<Window x:Class="HLOptimizerPro.App.Views.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="HL Optimizer Pro"
        Width="520"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontBody}">

  <Border Background="{StaticResource BrushBgBase}"
          BorderBrush="{StaticResource BrushGlassBorderStrong}"
          BorderThickness="1"
          CornerRadius="14"
          Margin="18"
          Padding="22"
          Effect="{StaticResource EffectPanelShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Cabeçalho: ícone + título -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
        <Border Width="42" Height="42"
                CornerRadius="12"
                Background="{StaticResource BrushAccentSubtle}"
                BorderBrush="{StaticResource BrushGlassBorderStrong}"
                BorderThickness="1">
          <iconPacks:PackIconMaterial x:Name="HeaderIcon"
                                      Kind="ShieldAlertOutline"
                                      Width="22" Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource BrushAccentBright}" />
        </Border>
        <TextBlock x:Name="TitleText"
                   Style="{StaticResource H2}"
                   Margin="14,0,0,0"
                   VerticalAlignment="Center"
                   Text="Título" />
      </StackPanel>

      <!-- Mensagem -->
      <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText"
                   Style="{StaticResource Secondary}"
                   TextWrapping="Wrap"
                   Text="Mensagem" />
      </ScrollViewer>

      <!-- Lista de alterações (modo Simular) -->
      <Border x:Name="ChangesPanel"
              Grid.Row="2"
              Visibility="Collapsed"
              Margin="0,14,0,0"
              Background="{StaticResource BrushBgSunken}"
              BorderBrush="{StaticResource BrushBorderSubtle}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">
        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ChangesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <Ellipse Width="5" Height="5"
                           Fill="{StaticResource BrushAccentBright}"
                           VerticalAlignment="Top"
                           Margin="0,7,10,0" />
                  <TextBlock Text="{Binding}"
                             Style="{StaticResource Caption}"
                             Foreground="{StaticResource BrushTextSecondary}"
                             MaxWidth="400" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Botões -->
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,20,0,0">
        <Button x:Name="CancelButton"
                Content="Cancelar"
                Style="{StaticResource ButtonSecondary}"
                Margin="0,0,10,0"
                Click="OnCancelClick" />
        <Button x:Name="ConfirmButton"
                Content="Continuar"
                Style="{StaticResource ButtonPrimary}"
                Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
