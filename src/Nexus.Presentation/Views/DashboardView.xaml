<UserControl x:Class="Nexus.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nexus.Presentation.Controls"
             xmlns:conv="clr-namespace:Nexus.Presentation.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <!-- Painel Principal (spec §4.1): score, cards de métricas reais,
         tendência (LiveCharts2) e recomendações ordenadas por impacto. -->
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <conv:RiskToBrushConverter x:Key="RiskToBrushConverter" />
        <conv:RiskToBadgeBrushConverter x:Key="RiskToBadgeBrushConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Painel Principal" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="· telemetria real do sistema"
                       FontSize="12"
                       Foreground="{StaticResource App.TextSecondary.Brush}"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
            <Button Content="Atualizar"
                    Style="{StaticResource GhostButton}"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- ═══ COLUNA ESQUERDA ═══════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Gauge + cards de métricas -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel VerticalAlignment="Center">
                        <controls:PerformanceGauge Value="{Binding Score}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ScoreNote}"
                                   FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource App.TextSecondary.Brush}"
                                   Margin="8,6,8,4" />
                    </StackPanel>
                </Border>

                <UniformGrid Grid.Column="1" Rows="3" Columns="2" Margin="12,0,0,0">

                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource SubtleText}" />
                            <TextBlock Text="{Binding CpuText}"
                                       FontFamily="{StaticResource App.MetricFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding CpuAvailable, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="uso do processador" Style="{StaticResource SubtleText}" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="RAM LIVRE" Style="{StaticResource SubtleText}" />
                            <TextBlock Text="{Binding RamText}"
                                       FontFamily="{StaticResource App.MetricFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding RamAvailable, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="{Binding RamSubText}" Style="{StaticResource SubtleText}" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DISCO LIVRE" Style="{StaticResource SubtleText}" />
                            <TextBlock Text="{Binding DiskText}"
                                       FontFamily="{StaticResource App.MetricFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding DiskAvailable, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="{Binding DiskSubText}" Style="{StaticResource SubtleText}" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="TEMPERATURA" Style="{StaticResource SubtleText}" />
                            <TextBlock Text="{Binding TempText}"
                                       FontFamily="{StaticResource App.MetricFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding TempAvailable, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="{Binding TempSubText}" Style="{StaticResource SubtleText}" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="PROCESSOS" Style="{StaticResource SubtleText}" />
                            <TextBlock Text="{Binding ProcessesText}"
                                       FontFamily="{StaticResource App.MetricFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding ProcessesAvailable, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="processos ativos" Style="{StaticResource SubtleText}" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="UPTIME" Style="{StaticResource SubtleText}" />
                            <TextBlock Text="{Binding UptimeText}"
                                       FontFamily="{StaticResource App.MetricFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding UptimeAvailable, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="desde o último arranque" Style="{StaticResource SubtleText}" FontSize="10" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- Gráfico de tendência (LiveCharts2) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Tendência (últimas horas)"
                               FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding ChartNote}"
                               FontSize="10"
                               Foreground="{StaticResource App.TextSecondary.Brush}"
                               Margin="0,6,0,0" />
                    <lvc:CartesianChart x:Name="TrendChart"
                                        Series="{Binding ChartSeries}"
                                        LegendPosition="Bottom"
                                        Margin="0,2,0,0" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ COLUNA DIREITA: RECOMENDAÇÕES ═════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Otimizações Recomendadas"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding RecommendationsNote}"
                           FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{StaticResource App.TextSecondary.Brush}"
                           Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource App.Background.Brush}"
                                    BorderBrush="{StaticResource App.Border.Brush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold" FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Background="{Binding Risk, Converter={StaticResource RiskToBadgeBrushConverter}}"
                                                CornerRadius="8"
                                                Padding="8,2"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding RiskText}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource App.TextSecondary.Brush}"
                                               Margin="0,6,0,8" />

                                    <ProgressBar Maximum="100"
                                                 Value="{Binding ImpactPercent}"
                                                 Height="4"
                                                 Foreground="{StaticResource App.Accent.Brush}"
                                                 Background="{StaticResource App.Border.Brush}"
                                                 BorderThickness="0" />

                                    <Grid Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ImpactText}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource App.TextSecondary.Brush}" />
                                            <TextBlock Text="· Reversível"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource App.Success.Brush}"
                                                       Margin="8,0,0,0"
                                                       Visibility="{Binding IsReversible, Converter={StaticResource BoolToVisConverter}}" />
                                        </StackPanel>
                                        <Button Content="{Binding ApplyButtonText}"
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="11" Padding="12,4"
                                                HorizontalAlignment="Right"
                                                Command="{Binding ApplyCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanApply}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
