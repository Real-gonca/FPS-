<UserControl x:Class="Nexus.Presentation.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexus.Presentation.Converters">

    <!-- Privacidade / Telemetria (spec §4.7): toggles REAIS sobre chaves
         conhecidas, cada um documentado, estado lido de probes reais. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="760" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Privacidade / Telemetria" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="· toggles reais, cada um documentado"
                       FontSize="12"
                       Foreground="{StaticResource App.TextSecondary.Brush}"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
            <Button Content="Reler estado"
                    Style="{StaticResource GhostButton}"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- Toggles -->
        <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Rows}" Margin="0,0,20,0"
                      VerticalAlignment="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold" FontSize="13.5"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource App.TextSecondary.Brush}"
                                           Margin="0,6,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource App.Background.Brush}"
                                            BorderBrush="{StaticResource App.Border.Brush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,2">
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource App.Cyan.Brush}" />
                                    </Border>
                                    <TextBlock Text="Requer administrador"
                                               FontSize="9.5"
                                               Foreground="{StaticResource App.TextSecondary.Brush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="{Binding ApplyButtonText}"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="11" Padding="12,4"
                                        Margin="0,0,0,6"
                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding ApplyEnabled}" />
                                <Button Content="Reverter (rollback)"
                                        Style="{StaticResource GhostButton}"
                                        FontSize="10.5" Padding="12,3"
                                        Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Nota -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Como isto funciona"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource App.TextSecondary.Brush}"
                           LineHeight="18">
                    <Run Text="O estado de cada toggle é lido de " />
                    <Run Text="fontes reais" FontWeight="SemiBold" Foreground="{StaticResource App.TextPrimary.Brush}" />
                    <Run Text=" (registry HKLM/HKCU e WMI) — se a fonte falhar, mostra " />
                    <Run Text="N/D" FontWeight="SemiBold" Foreground="{StaticResource App.TextPrimary.Brush}" />
                    <Run Text=". Aplicar segue o pipeline completo (backup → aplicar → histórico → rollback); " />
                    <Run Text="Reverter" FontWeight="SemiBold" Foreground="{StaticResource App.TextPrimary.Brush}" />
                    <Run Text=" resta o backup da última aplicação. Itens que exigem administrador ficam bloqueados em modo limitado, com explicação — nada roda 'de rastejo'." />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
