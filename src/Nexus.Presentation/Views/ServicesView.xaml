<UserControl x:Class="Nexus.Presentation.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexus.Presentation.Converters">

    <!-- Serviços (spec §4.6): inventário real (WMI), ações via sc.exe
         whitelisted, perfis com preview de impacto. Tudo reversível. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Serviços" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="· gestão real (WMI + sc.exe na whitelist)"
                       FontSize="12"
                       Foreground="{StaticResource App.TextSecondary.Brush}"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
            <Button Content="Atualizar"
                    Style="{StaticResource GhostButton}"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- ═══ ESQUERDA: PERFIS + INVENTÁRIO ════════════════════════ -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Perfis -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Perfis de otimização (preview antes de aplicar)"
                               FontSize="13" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource App.Background.Brush}"
                                        BorderBrush="{StaticResource App.Border.Brush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ChangesCount, StringFormat='{}{0} alterações'}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource App.TextSecondary.Brush}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <Button Content="{Binding ApplyButtonText}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    FontSize="11" Padding="12,4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="ProfileApply_Click"
                                                    Tag="{Binding}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource App.TextSecondary.Brush}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource App.Cyan.Brush}"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVisConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Inventário -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Inventário" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FilteredCount, StringFormat='{}({0})'}"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextSecondary.Brush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Margin="16,0,8,0"
                                 Background="{StaticResource App.Background.Brush}"
                                 BorderBrush="{StaticResource App.Border.Brush}"
                                 BorderThickness="1"
                                 Foreground="{StaticResource App.TextPrimary.Brush}"
                                 CaretBrush="{StaticResource App.TextPrimary.Brush}"
                                 VerticalContentAlignment="Center"
                                 Padding="8,4" />
                        <ComboBox ItemsSource="{x:Static conv:StateFilterOptions.All}"
                                  SelectedItem="{Binding StateFilter}"
                                  Width="130"
                                  Background="{StaticResource App.Background.Brush}"
                                  Foreground="{StaticResource App.TextPrimary.Brush}"
                                  BorderBrush="{StaticResource App.Border.Brush}"
                                  VerticalContentAlignment="Center"
                                  Padding="8,4" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding StatusText}"
                               FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource App.TextSecondary.Brush}"
                               Margin="0,8,0,0" />

                    <DataGrid ItemsSource="{Binding FilteredServices}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Serviço" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" Width="100" />
                            <DataGridTextColumn Header="Arranque" Binding="{Binding StartModeText}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ DIREITA: AÇÕES DO SERVIÇO SELECIONADO ═══════════════ -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Ações (serviço selecionado)"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <TextBlock DockPanel.Dock="Bottom"
                           Text="Cada ação mostra preview de impacto e exige confirmação. Todas ficam no histórico com rollback individual (o estado anterior fica guardado no backup)."
                           FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource App.TextSecondary.Brush}"
                           Margin="0,10,0,0"
                           Opacity="0.8" />

                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedName}"
                               FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    <TextBlock FontSize="10.5"
                               Foreground="{StaticResource App.TextSecondary.Brush}"
                               Margin="0,0,0,14">
                        <Run Text="Estado: " /><Run Text="{Binding Selected.StateText, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="Arranque: " /><Run Text="{Binding Selected.StartModeText, Mode=OneWay}" />
                    </TextBlock>

                    <Button Content="Iniciar serviço"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding StartCommand}"
                            CommandParameter="{Binding Selected}"
                            IsEnabled="{Binding Selected, Converter={StaticResource NullToBoolConverter}}" />
                    <Button Content="Parar serviço"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding StopCommand}"
                            CommandParameter="{Binding Selected}"
                            IsEnabled="{Binding Selected, Converter={StaticResource NullToBoolConverter}}" />
                    <Button Content="Habilitar (arranque manual)"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding EnableCommand}"
                            CommandParameter="{Binding Selected}"
                            IsEnabled="{Binding Selected, Converter={StaticResource NullToBoolConverter}}" />
                    <Button Content="Desativar (não arrancar)"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DisableCommand}"
                            CommandParameter="{Binding Selected}"
                            IsEnabled="{Binding Selected, Converter={StaticResource NullToBoolConverter}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
