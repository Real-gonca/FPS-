<Window x:Class="Nexus.Presentation.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{StaticResource App.Background.Brush}"
        TextElement.Foreground="{StaticResource App.TextPrimary.Brush}"
        FontFamily="Segoe UI">

    <Border BorderBrush="{StaticResource App.Border.Brush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <StackPanel>
            <TextBlock x:Name="HeaderText"
                       Text="Confirmar"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText"
                       Text=""
                       FontSize="12.5" TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <Border x:Name="DetailsBox"
                    Background="{StaticResource App.Surface.Brush}"
                    BorderBrush="{StaticResource App.Border.Brush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsText"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource App.TextSecondary.Brush}" />
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancelar"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button x:Name="OkButton"
                        Content="Confirmar"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
