<UserControl x:Class="Nexus.Presentation.Controls.PerformanceGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240" Height="240">

    <!--
      Gauge circular de Score de Desempenho (spec §3.2): arco de 270°,
      cor dinâmica por faixa, valor em fonte tabular. Sem score real → "N/D".
    -->
    <Viewbox Stretch="Uniform">
        <Grid Width="200" Height="200">
            <Path x:Name="TrackArc"
                  Stroke="{StaticResource App.Border.Brush}"
                  StrokeThickness="13"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Opacity="0.7" />

            <Path x:Name="ValueArc"
                  StrokeThickness="13"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect
                                      Color="#3B82F6"
                                      BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.55" />
                </Path.Effect>
            </Path>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ValueText"
                           Text="N/D"
                           FontSize="46"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="BandText"
                           Text="—"
                           FontSize="12"
                           Foreground="{StaticResource App.TextSecondary.Brush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="SCORE DE DESEMPENHO"
                           FontSize="9"
                           Foreground="{StaticResource App.TextSecondary.Brush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
