<Window x:Class="HL.Optimizer.Pro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:HL.Optimizer.Pro.ViewModels"
        xmlns:views="clr-namespace:HL.Optimizer.Pro.Views"
        mc:Ignorable="d"
        Title="HL OPTIMIZER PRO" Height="850" Width="1350"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource PrimaryDarkBrush}"
        WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="1100">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryGradientBrush}" VerticalAlignment="Center">
                        <TextBlock Text="HL" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HL OPTIMIZER PRO" Foreground="White" FontWeight="Bold" FontSize="13" LetterSpacing="0.5"/>
                        <TextBlock Text="Mais Desempenho. Mais Estabilidade. Mais Você." Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Height="36" Background="{StaticResource SurfaceDarkBrush}" CornerRadius="{StaticResource MediumCorner}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" 
                                 VerticalAlignment="Center" FontSize="12"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Pesquisar otimizações, ferramentas ou configurações...">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextTertiaryBrush}" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ComboBox Width="110" Height="32" Margin="0,0,8,0" Background="{StaticResource SurfaceDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                              SelectedItem="{Binding SelectedLanguage}" ItemsSource="{Binding AvailableLanguages}"
                              BorderBrush="{StaticResource BorderDarkBrush}" FontSize="11">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Style="{StaticResource IconButton}" ToolTip="Notificações" Command="{Binding ClearNotificationsCommand}" Margin="0,0,4,0">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="14"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource ErrorBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                    Visibility="{Binding Notifications.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource IconButton}" ToolTip="Configurações" Command="{Binding OpenSettingsCommand}" Margin="0,0,12,0">
                        <TextBlock Text="⚙" FontSize="14"/>
                    </Button>

                    <Border Width="1" Height="20" Background="{StaticResource BorderDarkBrush}" Margin="0,0,12,0"/>

                    <Button Style="{StaticResource IconButton}" Content="─" FontWeight="Bold" Command="{Binding MinimizeCommand}" Width="32"/>
                    <Button Style="{StaticResource IconButton}" Content="☐" FontSize="11" Command="{Binding MaximizeCommand}" Width="32"/>
                    <Button Style="{StaticResource IconButton}" Content="✕" FontWeight="Bold" Command="{Binding CloseCommand}" Width="32">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF3B30"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SecondaryDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="12,12,12,0">
                        <StackPanel>
                            <TextBlock Text="PRINCIPAL" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" FontWeight="Bold" Margin="12,8,0,8" LetterSpacing="1"/>

                            <RadioButton Style="{StaticResource SidebarButton}" Content="Painel Principal" Tag="🏠" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Booster" Tag="🚀" Command="{Binding NavigateCommand}" CommandParameter="Booster"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Tweaks" Tag="⚙" Command="{Binding NavigateCommand}" CommandParameter="Tweaks"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Limpeza" Tag="🧹" Command="{Binding NavigateCommand}" CommandParameter="Cleanup"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Jogos" Tag="🎮" Command="{Binding NavigateCommand}" CommandParameter="Games"/>

                            <TextBlock Text="SISTEMA" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" FontWeight="Bold" Margin="12,20,0,8" LetterSpacing="1"/>

                            <RadioButton Style="{StaticResource SidebarButton}" Content="Sistema" Tag="🖥" Command="{Binding NavigateCommand}" CommandParameter="System"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Diagnóstico" Tag="🔍" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Monitor de Desempenho" Tag="📊" Command="{Binding NavigateCommand}" CommandParameter="Performance"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Inicialização" Tag="⚡" Command="{Binding NavigateCommand}" CommandParameter="Startup"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Ferramentas Avançadas" Tag="🛠" Command="{Binding NavigateCommand}" CommandParameter="Tools"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Restauração" Tag="♻" Command="{Binding NavigateCommand}" CommandParameter="Restore"/>

                            <TextBlock Text="CONFIGURAÇÕES" Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" FontWeight="Bold" Margin="12,20,0,8" LetterSpacing="1"/>
                            <RadioButton Style="{StaticResource SidebarButton}" Content="Configurações" Tag="⚙" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- System Status Mini Card -->
                    <Border Grid.Row="1" Margin="12" Padding="14" Background="{StaticResource CardDarkBrush}" CornerRadius="{StaticResource LargeCorner}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource SuccessGradientBrush}">
                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SystemStatus}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding OptimizationIndex.Percentage, StringFormat={}{0:0}%}" Foreground="{StaticResource AccentGreenBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text=" otimizado" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <Grid Grid.Column="1" Background="{StaticResource PrimaryDarkBrush}">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                            <views:DashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:BoosterViewModel}">
                            <views:BoosterView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:TweaksViewModel}">
                            <views:TweaksView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:CleanupViewModel}">
                            <views:CleanupView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:GamesViewModel}">
                            <views:GamesView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:SystemInfoViewModel}">
                            <views:SystemView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:DiagnosticsViewModel}">
                            <views:DiagnosticsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:PerformanceMonitorViewModel}">
                            <views:PerformanceMonitorView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:StartupViewModel}">
                            <views:StartupView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ToolsViewModel}">
                            <views:ToolsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:RestoreViewModel}">
                            <views:RestoreView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                            <views:SettingsView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <!-- Admin Warning -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,12,12,0" Background="#FFB020" CornerRadius="{StaticResource SmallCorner}" Padding="12,6"
                        Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="Black" FontWeight="Bold" Margin="0,0,6,0"/>
                        <TextBlock Text="Execute como administrador para otimizações completas" Foreground="Black" FontSize="11" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
