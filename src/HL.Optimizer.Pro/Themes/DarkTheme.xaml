<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- HL OPTIMIZER PRO - Premium Dark Theme -->
    <!-- Palette: Deep Blue / Electric Blue / White / Green accent -->

    <Color x:Key="PrimaryDarkColor">#0A1628</Color>
    <Color x:Key="SecondaryDarkColor">#111F3A</Color>
    <Color x:Key="CardDarkColor">#162447</Color>
    <Color x:Key="SurfaceDarkColor">#1B2E5C</Color>
    <Color x:Key="BorderDarkColor">#243A6B</Color>

    <Color x:Key="ElectricBlueColor">#2D7FF9</Color>
    <Color x:Key="ElectricBlueLightColor">#4D94FF</Color>
    <Color x:Key="ElectricBlueDarkColor">#1A5FCC</Color>

    <Color x:Key="AccentGreenColor">#00D26A</Color>
    <Color x:Key="AccentGreenLightColor">#00F07C</Color>
    <Color x:Key="AccentGreenDarkColor">#00A854</Color>

    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#8EA2C8</Color>
    <Color x:Key="TextTertiaryColor">#5A7196</Color>

    <Color x:Key="WarningColor">#FFB020</Color>
    <Color x:Key="ErrorColor">#FF4D6A</Color>
    <Color x:Key="InfoColor">#2D7FF9</Color>

    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDarkColor}"/>
    <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource CardDarkColor}"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDarkColor}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}"/>

    <SolidColorBrush x:Key="ElectricBlueBrush" Color="{StaticResource ElectricBlueColor}"/>
    <SolidColorBrush x:Key="ElectricBlueLightBrush" Color="{StaticResource ElectricBlueLightColor}"/>
    <SolidColorBrush x:Key="ElectricBlueDarkBrush" Color="{StaticResource ElectricBlueDarkColor}"/>

    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentGreenLightBrush" Color="{StaticResource AccentGreenLightColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2D7FF9" Offset="0"/>
        <GradientStop Color="#1A5FCC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#162447" Offset="0"/>
        <GradientStop Color="#111F3A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D26A" Offset="0"/>
        <GradientStop Color="#00A854" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>

    <!-- Shadows -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="12" ShadowDepth="0" Opacity="0.25" Color="#2D7FF9"/>
    <DropShadowEffect x:Key="GreenShadow" BlurRadius="12" ShadowDepth="0" Opacity="0.3" Color="#00D26A"/>

    <!-- Corner Radius -->
    <CornerRadius x:Key="SmallCorner">6</CornerRadius>
    <CornerRadius x:Key="MediumCorner">10</CornerRadius>
    <CornerRadius x:Key="LargeCorner">14</CornerRadius>
    <CornerRadius x:Key="ExtraLargeCorner">18</CornerRadius>

</ResourceDictionary>
