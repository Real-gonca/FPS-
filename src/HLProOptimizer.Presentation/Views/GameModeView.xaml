<!--
  MODO GAMER: estado da sessão, ganho estimado, tweaks selecionáveis, boost de
  processo e log ao vivo. A detecção automática de jogos vem do IGameSessionWatcher.
-->
<UserControl x:Class="HLProOptimizer.Presentation.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:HLProOptimizer.Presentation.Localization"
             Background="Transparent">

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc Game_Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{loc:Loc Game_Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Ghost}" Content="{loc:Loc Common_Refresh}" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                        Content="{loc:Loc Game_Deactivate}" Command="{Binding DeactivateCommand}"
                        Visibility="{Binding IsActive, Converter={StaticResource Conv.BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Primary}" Margin="10,0,0,0"
                        Content="{loc:Loc Game_Activate}" Command="{Binding ActivateCommand}"
                        Visibility="{Binding IsInactive, Converter={StaticResource Conv.BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Estado -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{loc:Loc Common_Status}" Style="{StaticResource Text.SectionTitle}" />
                            <Border HorizontalAlignment="Right" CornerRadius="{StaticResource Radius.Pill}" Padding="10,3">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Danger.Soft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Success.Soft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding EstimatedFpsGainText}" FontSize="40" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Accent}" Margin="0,14,0,0" />
                        <TextBlock Text="{loc:Loc Game_FpsGain}" Style="{StaticResource Text.Caption}" Margin="0,-4,0,0" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc Game_Tweaks}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding AppliedCount}" Style="{StaticResource Text.Metric}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc Opt_Failed}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding FailedCount}" Style="{StaticResource Text.Metric}"
                                           Foreground="{StaticResource Brush.Danger}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc Game_FreedMemory}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding FreedMemoryText}" Style="{StaticResource Text.Subtitle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc Game_ActiveSince}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding ActiveSinceText}" Style="{StaticResource Text.Subtitle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc Game_Terminated}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding TerminatedText}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock Text="{loc:Loc Game_DetectedGame}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding CurrentGameText}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preferências -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Opt_Options}" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />

                        <CheckBox Style="{StaticResource CheckBox.Switch}" Content="{loc:Loc Game_AutoDisable}"
                                  IsChecked="{Binding AutoDisableOnGameExit}" Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource CheckBox.Switch}" Content="{loc:Loc Game_KillBackground}"
                                  IsChecked="{Binding KillBackgroundProcesses}" Margin="0,0,0,10" />

                        <TextBlock Text="{loc:Loc Game_BoostProcess}" Style="{StaticResource Text.Caption}" Margin="0,8,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource TextBox.Default}"
                                     Text="{Binding BoostProcessName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                                    Content="{loc:Loc Common_Apply}" Command="{Binding BoostProcessCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tweaks + log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Loc Game_Tweaks}" Style="{StaticResource Text.SectionTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Ghost}" Content="{loc:Loc Common_SelectAll}"
                                        Command="{Binding EnableAllTweaksCommand}" />
                                <Button Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                        Content="{loc:Loc Common_Recommended}" Command="{Binding EnableRecommendedTweaksCommand}" />
                                <Button Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                        Content="{loc:Loc Common_ClearSelection}" Command="{Binding DisableAllTweaksCommand}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tweaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                                                Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" Style="{StaticResource CheckBox.Switch}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Margin="14,0">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Subtitle}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Caption}"
                                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Brush.Accent}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.Success.Soft}"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding EstimatedFpsGain, StringFormat=+{0} FPS}" FontSize="11"
                                                                   Foreground="{StaticResource Brush.Success}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Background="{StaticResource Brush.Warning.Soft}"
                                                            HorizontalAlignment="Right" Margin="0,6,0,0"
                                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource Conv.BoolToVisibility}}">
                                                        <TextBlock Text="{loc:Loc Tools_RequiresAdmin}" FontSize="10"
                                                                   Foreground="{StaticResource Brush.Warning}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc Opt_LiveLog}" Style="{StaticResource Text.SectionTitle}" />
                            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                                    Content="{loc:Loc Common_ClearSelection}" Command="{Binding ClearLogCommand}" />
                        </Grid>
                        <Border Background="{StaticResource Brush.Surface.Input}" CornerRadius="{StaticResource Radius.Control}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="12">
                            <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12" MaxHeight="150"
                                     Foreground="{StaticResource Brush.Text.Secondary}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
