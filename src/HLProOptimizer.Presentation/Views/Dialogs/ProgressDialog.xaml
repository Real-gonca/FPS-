<!--
  ============================================================================
  ProgressDialog: janela de progresso com log em tempo real e cancelamento.
  ----------------------------------------------------------------------------
  Usada por operacoes longas (scan, otimizacao, limpeza, SFC/DISM).
  O ViewModel da operacao reporta IProgress<ScanProgress>; cada amostra vira uma
  linha no log e atualiza a barra (percentual calculado por CompletedSteps/TotalSteps).
  ============================================================================
-->
<Window x:Class="HLProOptimizer.Presentation.Views.Dialogs.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HLProOptimizer.Presentation.Localization"
        Title="HL PRO OPTIMIZER"
        Width="640"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="OnDragMove">

    <Border Margin="16"
            Style="{StaticResource Card.Solid}"
            Padding="24"
            Effect="{StaticResource Shadow.Raised}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Titulo + fechar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40"
                            CornerRadius="12"
                            Background="{StaticResource Brush.Primary.Soft}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#x23F1;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="18"
                                   Foreground="{StaticResource Brush.Accent.Solid}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleText"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.SubsectionTitle}" />
                </StackPanel>

                <TextBlock x:Name="ElapsedText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Caption}"
                           Text="00:00" />
            </Grid>

            <!-- Etapa atual + percentual -->
            <Grid Grid.Row="1" Margin="0,20,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StepText"
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           Text="{loc:Loc Common_Loading}" />

                <TextBlock x:Name="PercentText"
                           Grid.Column="1"
                           Style="{StaticResource Text.Body}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent.Solid}"
                           Text="0%" />
            </Grid>

            <!-- Barra de progresso -->
            <ProgressBar x:Name="Progress"
                         Grid.Row="2"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />

            <!-- Log em tempo real -->
            <Border Grid.Row="3"
                    Margin="0,16,0,0"
                    Background="{StaticResource Brush.Surface.Input}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}">
                <ListBox x:Name="LogList"
                         Style="{StaticResource ListBox.Plain}"
                         Padding="12"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Timestamp}"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Acoes -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Loc Common_Cancel}"
                        Click="OnCancelClick" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource Button.Primary}"
                        Content="{loc:Loc Common_Close}"
                        Visibility="Collapsed"
                        IsDefault="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
