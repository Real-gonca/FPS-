<!--
  ============================================================================
  MessageDialog: caixa de mensagem/confirmacao do tema dark premium.
  ----------------------------------------------------------------------------
  Substitui o MessageBox padrao do Windows para manter a identidade visual.
  Suporta os modos Info / Aviso / Erro / Sucesso e confirmacao (Sim/Cancelar),
  com destaque vermelho quando a acao e destrutiva.
  ============================================================================
-->
<Window x:Class="HLProOptimizer.Presentation.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HLProOptimizer.Presentation.Localization"
        Title="HL PRO OPTIMIZER"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="OnDragMove">

    <Border Margin="16"
            Style="{StaticResource Card.Solid}"
            Padding="24"
            Effect="{StaticResource Shadow.Raised}">
        <StackPanel>

            <!-- Cabecalho: icone + titulo -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost"
                        Width="44" Height="44"
                        CornerRadius="12"
                        Background="{StaticResource Brush.Primary.Soft}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph"
                               Text="&#x2756;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="20"
                               Foreground="{StaticResource Brush.Accent.Solid}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource Text.SubsectionTitle}" />

                <Button Grid.Column="2"
                        Style="{StaticResource Button.TitleBar}"
                        Content="&#x2715;"
                        Click="OnCancelClick"
                        ToolTip="{loc:Loc Common_Close}" />
            </Grid>

            <!-- Mensagem -->
            <TextBlock x:Name="MessageText"
                       Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       Margin="58,0,0,20"
                       TextWrapping="Wrap" />

            <!-- Botoes -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Style="{StaticResource Button.Secondary}"
                        Content="{loc:Loc Common_Cancel}"
                        Margin="0,0,10,0"
                        Click="OnCancelClick" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource Button.Primary}"
                        Content="{loc:Loc Common_Ok}"
                        IsDefault="True"
                        Click="OnConfirmClick" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
