<!--
  ============================================================================
  OptimizationResultDialog: resumo de uma otimizacao/limpeza executada.
  ----------------------------------------------------------------------------
  Mostra as metricas agregadas (etapas ok/ignoradas/falhas, espaco liberado,
  duracao) e o detalhe por etapa. Quando algum passo exigia administrador e foi
  ignorado, exibe o botao "Reexecutar como administrador" (elevacao sob demanda).
  ============================================================================
-->
<Window x:Class="HLProOptimizer.Presentation.Views.Dialogs.OptimizationResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HLProOptimizer.Presentation.Localization"
        xmlns:conv="clr-namespace:HLProOptimizer.Presentation.Converters"
        Title="HL PRO OPTIMIZER"
        Width="620"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="OnDragMove">

    <Window.Resources>
        <conv:BytesToTextConverter x:Key="Bytes" />
        <conv:TimeSpanToTextConverter x:Key="TimeSpan" />
    </Window.Resources>

    <Border Margin="16"
            Style="{StaticResource Card.Solid}"
            Padding="26"
            Effect="{StaticResource Shadow.Raised}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabecalho -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost"
                        Width="52" Height="52"
                        CornerRadius="16"
                        Background="{StaticResource Brush.Success.Soft}">
                    <TextBlock x:Name="IconGlyph"
                               Text="&#x2713;"
                               FontFamily="Segoe UI Symbol"
                               FontSize="24"
                               Foreground="{StaticResource Brush.Success}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource Text.SubsectionTitle}"
                               Text="{loc:Loc Opt_Completed}" />
                    <TextBlock x:Name="SubtitleText"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource Button.TitleBar}"
                        Content="&#x2715;"
                        Click="OnCloseClick"
                        ToolTip="{loc:Loc Common_Close}" />
            </Grid>

            <!-- Metricas -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,0">
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="SuccessMetric" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Success}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc Opt_StepsExecuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="FreedMetric" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Accent.Solid}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc Opt_SpaceFreed}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="DurationMetric" Style="{StaticResource Text.Metric}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc Opt_Duration}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="IssuesMetric" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Warning}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Loc Opt_Skipped}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Aviso de elevacao -->
            <Border x:Name="ElevationBanner"
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    Background="{StaticResource Brush.Warning.Soft}"
                    BorderBrush="{StaticResource Brush.Warning}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}"
                    Padding="14,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#x26A0;"
                               FontFamily="Segoe UI Symbol"
                               Foreground="{StaticResource Brush.Warning}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Msg_NeedAdmin}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource Button.Small}"
                            Content="{loc:Loc App_Elevate}"
                            Click="OnRetryElevatedClick" />
                </Grid>
            </Border>

            <!-- Detalhe por etapa -->
            <Border Grid.Row="3"
                    Margin="0,14,0,0"
                    Background="{StaticResource Brush.Surface.Input}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}">
                <ListBox x:Name="StepList"
                         Style="{StaticResource ListBox.Plain}"
                         Padding="8"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" CornerRadius="8" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock FontFamily="Segoe UI Symbol"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#x2713;" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Skipped}" Value="True">
                                                        <Setter Property="Text" Value="&#x26A0;" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Text" Value="&#x2716;" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StepName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Message}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Text.Caption}"
                                               Text="{Binding BytesFreed, Converter={StaticResource Bytes}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Rodape -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource Button.Primary}"
                        Content="{loc:Loc Common_Close}"
                        IsDefault="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
