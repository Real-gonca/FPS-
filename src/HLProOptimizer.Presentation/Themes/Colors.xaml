<!--
  ============================================================================
  TEMA: PALETA DARK PREMIUM (glassmorphism + gradientes azul → ciano)
  ----------------------------------------------------------------------------
  Convenção de nomes:
    Brush.<Papel>[.<Variação>]   → recursos prontos para uso em Background/Foreground
    Color.<Papel>                → Color cru (necessário em animações/gradientes)
    Shadow.<Papel>               → DropShadowEffect reutilizável

  As cores seguem o guia de design do produto:
    fundo quase preto azulado, superfícies em camadas translúcidas,
    acento primário azul (#2563EB) degradê para ciano (#06B6D4).
  ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ------------------------------------------------------------------ Cores cruas -->
    <Color x:Key="Color.Background.Deep">#FF05070D</Color>
    <Color x:Key="Color.Background.App">#FF0A0E19</Color>
    <Color x:Key="Color.Background.Side">#FF0D1322</Color>
    <Color x:Key="Color.Surface">#FF121A2C</Color>
    <Color x:Key="Color.Surface.Raised">#FF18213A</Color>
    <Color x:Key="Color.Surface.Input">#FF0F1626</Color>
    <Color x:Key="Color.Border">#FF212C46</Color>
    <Color x:Key="Color.Border.Strong">#FF2E3C5E</Color>
    <Color x:Key="Color.Primary">#FF2563EB</Color>
    <Color x:Key="Color.Primary.Light">#FF3B82F6</Color>
    <Color x:Key="Color.Accent">#FF06B6D4</Color>
    <Color x:Key="Color.Accent.Light">#FF22D3EE</Color>
    <Color x:Key="Color.Text.Primary">#FFE8EEF9</Color>
    <Color x:Key="Color.Text.Secondary">#FF9AA8C4</Color>
    <Color x:Key="Color.Text.Muted">#FF61708D</Color>
    <Color x:Key="Color.Success">#FF22C55E</Color>
    <Color x:Key="Color.Warning">#FFF59E0B</Color>
    <Color x:Key="Color.Danger">#FFEF4444</Color>
    <Color x:Key="Color.Info">#FF38BDF8</Color>

    <!-- ------------------------------------------------------------------ Fundos -->
    <!-- Fundo do aplicativo: gradiente radial discreto (efeito "profundidade"). -->
    <LinearGradientBrush x:Key="Brush.Background.App" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Background.App}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Background.Deep}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Background.Side" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Background.Side}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Background.Deep}" Offset="1" />
    </LinearGradientBrush>

    <!-- Halo decorativo do cabeçalho (glassmorphism). -->
    <RadialGradientBrush x:Key="Brush.Background.Halo" GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#332563EB" Offset="0" />
        <GradientStop Color="#1406B6D4" Offset="0.45" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <!-- ------------------------------------------------------------------ Superfícies -->
    <!-- Cartão "vidro": branco translúcido sobre o fundo escuro. -->
    <LinearGradientBrush x:Key="Brush.Surface.Card" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Surface.CardHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#29FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Brush.Surface.Input" Color="{StaticResource Color.Surface.Input}" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Glass.Strong" Color="#1AFFFFFF" />

    <!-- ------------------------------------------------------------------ Bordas -->
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Border.Glass" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border.Transparent" Color="#00FFFFFF" />

    <!-- ------------------------------------------------------------------ Marca (gradiente primário) -->
    <LinearGradientBrush x:Key="Brush.Primary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Primary}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Accent}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Primary.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Primary.Light}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Accent.Light}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Primary.Pressed" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1D4ED8" Offset="0" />
        <GradientStop Color="#FF0891B2" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Primary.Solid" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Solid" Color="{StaticResource Color.Accent.Light}" />

    <!-- ------------------------------------------------------------------ Texto -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#FF05070D" />
    <SolidColorBrush x:Key="Brush.Text.Gradient" Color="{StaticResource Color.Accent.Light}" />

    <!-- ------------------------------------------------------------------ Estados semânticos -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#1F22C55E" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#1FF59E0B" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#1FEF4444" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#1F38BDF8" />
    <SolidColorBrush x:Key="Brush.Primary.Soft" Color="#262563EB" />

    <!-- ------------------------------------------------------------------ Séries dos gráficos -->
    <SolidColorBrush x:Key="Brush.Series.Cpu" Color="{StaticResource Color.Accent.Light}" />
    <SolidColorBrush x:Key="Brush.Series.Memory" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="Brush.Series.Disk" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Series.Network" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Series.Gpu" Color="#FFF472B6" />

    <!-- ------------------------------------------------------------------ Sombras -->
    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="24" ShadowDepth="4" Direction="270" Color="#B3000000" Opacity="0.55" />
    <DropShadowEffect x:Key="Shadow.Raised" BlurRadius="34" ShadowDepth="8" Direction="270" Color="#CC000000" Opacity="0.6" />
    <DropShadowEffect x:Key="Shadow.Glow" BlurRadius="20" ShadowDepth="0" Color="{StaticResource Color.Primary}" Opacity="0.55" />
    <DropShadowEffect x:Key="Shadow.Text" BlurRadius="12" ShadowDepth="0" Color="{StaticResource Color.Accent}" Opacity="0.45" />

    <!-- ------------------------------------------------------------------ Medidas do design system -->
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <sys:Double x:Key="Size.Font.Title">28</sys:Double>
    <sys:Double x:Key="Size.Font.Section">20</sys:Double>
    <sys:Double x:Key="Size.Font.Subsection">16</sys:Double>
    <sys:Double x:Key="Size.Font.Body">14</sys:Double>
    <sys:Double x:Key="Size.Font.Caption">12</sys:Double>
    <Thickness x:Key="Padding.Card">20</Thickness>
    <Thickness x:Key="Padding.Control">14,10</Thickness>
    <sys:TimeSpan x:Key="Duration.Fast">0:0:0.18</sys:TimeSpan>
    <sys:TimeSpan x:Key="Duration.Normal">0:0:0.25</sys:TimeSpan>

</ResourceDictionary>
