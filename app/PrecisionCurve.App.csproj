<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PrecisionCurve - tray application (.NET 8, WPF)

    WinForms is enabled only for NotifyIcon: WPF still has no first-party tray
    API, and pulling a third-party package in for one icon is not worth it.

    Build:  dotnet build app/PrecisionCurve.App.csproj -c Release
    Run:    dotnet run --project app/PrecisionCurve.App.csproj
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PrecisionCurve</AssemblyName>
    <RootNamespace>PrecisionCurve</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Product>PrecisionCurve</Product>
    <Company>PrecisionCurve Project</Company>
    <Description>Mouse acceleration, DPI stages and axis snapping for Windows.</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden vectors for --selftest: proves the C# math matches the C math. -->
    <None Include="..\tests\parity\vectors.json" Link="vectors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
