<Window x:Class="PrecisionCurve.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrecisionCurve.Controls"
        Title="PrecisionCurve"
        Width="1200" Height="780"
        MinWidth="1040" MinHeight="700"
        Background="{StaticResource BgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentGradient}">
                    <Path Data="M 6,20 C 10,20 12,8 17,8 C 22,8 24,20 28,20"
                          Stroke="#FF08111F" StrokeThickness="2.2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Margin="6" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PrecisionCurve" Style="{StaticResource H1}" />
                    <TextBlock Text="mouse input shaping · kernel filter" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                <Border Style="{StaticResource Pill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DriverConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DriverStatus}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Acceleration" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
                <ToggleButton Style="{StaticResource SwitchToggle}"
                              IsChecked="{Binding AccelerationEnabled, Mode=TwoWay}"
                              ToolTip="Master switch (Ctrl+Alt+E)" />
            </StackPanel>
        </Grid>

        <!-- ============================= body ============================= -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ================ profiles ================ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROFILES" Style="{StaticResource SectionTitle}" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <CheckBox Content="Auto-switch by active process"
                                  IsChecked="{Binding AutoSwitch, Mode=TwoWay}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PresetBox" Grid.Column="0"
                                      ItemsSource="{Binding PresetNames}" SelectedIndex="0" />
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding Commands.NewProfile}"
                                    CommandParameter="{Binding ElementName=PresetBox, Path=SelectedItem}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Duplicate" Style="{StaticResource GhostButton}"
                                    Command="{Binding Commands.DuplicateProfile}" />
                            <Button Grid.Column="1" Content="Delete" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding Commands.DeleteProfile}" />
                        </Grid>
                        <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding EffectiveDpiText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ================ curve + sliders ================ -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,12,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="ACCELERATION CURVE" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                        <ComboBox HorizontalAlignment="Right" Width="140"
                                  ItemsSource="{Binding CurveModes}"
                                  SelectedItem="{Binding Mode, Mode=TwoWay}" />
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>

                        <!-- base -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Base" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.1" Maximum="3" SmallChange="0.01"
                                Value="{Binding Base, Mode=TwoWay}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Base, StringFormat='{}{0:0.00}x'}" />

                        <!-- offset -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset (c/ms)" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="30" SmallChange="0.1"
                                Value="{Binding Offset, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Offset, StringFormat='{}{0:0.0}'}" />

                        <!-- acceleration -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Acceleration" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.005"
                                Value="{Binding Accel, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Accel, StringFormat='{}{0:0.000}'}" />

                        <!-- exponent -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Exponent" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0.25" Maximum="6" SmallChange="0.05"
                                Value="{Binding Exponent, Mode=TwoWay}" IsEnabled="{Binding IsExponentRelevant}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Exponent, StringFormat='{}{0:0.00}'}" />

                        <!-- cap -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Cap" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" />
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="0.2" Maximum="10" SmallChange="0.05"
                                Value="{Binding Cap, Mode=TwoWay}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Cap, StringFormat='{}{0:0.00}x'}" />

                        <!-- max speed -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Max speed" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" />
                        <Slider Grid.Row="5" Grid.Column="1" Minimum="5" Maximum="200" SmallChange="1"
                                Value="{Binding MaxSpeed, Mode=TwoWay}" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding MaxSpeed, StringFormat='{}{0:0} c/ms'}" />
                    </Grid>

                    <controls:CurveGraph x:Name="Graph" MinHeight="240" />
                </DockPanel>
            </Border>

            <!-- ================ stages / snap / diagnostics ================ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DPI STAGES" Style="{StaticResource SectionTitle}" />
                            <ListBox ItemsSource="{Binding Stages}"
                                     SelectedItem="{Binding SelectedStage, Mode=TwoWay}"
                                     MaxHeight="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                            <TextBlock Text="{Binding ScaleText}" HorizontalAlignment="Right"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Add stage" Style="{StaticResource GhostButton}"
                                        Command="{Binding Commands.AddStage}" />
                                <Button Grid.Column="1" Content="Remove" Margin="6,0,0,0"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding Commands.RemoveStage}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Stage X" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0.05" Maximum="4" SmallChange="0.01"
                                        Value="{Binding SelectedStage.ScaleX, Mode=TwoWay}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}"
                                           Text="{Binding SelectedStage.ScaleX, StringFormat='{}{0:0.00}x'}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Stage Y" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.05" Maximum="4" SmallChange="0.01"
                                        Value="{Binding SelectedStage.ScaleY, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                           Text="{Binding SelectedStage.ScaleY, StringFormat='{}{0:0.00}x'}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sensor DPI" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                         Text="{Binding HardwareDpi, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding EffectiveDpiText}"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="6,6,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="AXIS SNAP" Style="{StaticResource SectionTitle}" />

                            <CheckBox Content="Snap movement to axes" IsChecked="{Binding SnapEnabled, Mode=TwoWay}" />

                            <Grid Margin="0,10,0,0" IsEnabled="{Binding SnapEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Lines" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="4"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding SnapLines, Mode=TwoWay}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueText}"
                                           Text="{Binding SnapLines}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tolerance" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="30" SmallChange="0.5"
                                        Value="{Binding SnapTolerance, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                           Text="{Binding SnapTolerance, StringFormat='{}{0:0.0}°'}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Strength" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05"
                                        Value="{Binding SnapStrength, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}"
                                           Text="{Binding SnapStrength, StringFormat='{}{0:0.00}'}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox Content="Invert X" IsChecked="{Binding InvertX, Mode=TwoWay}" Margin="0,0,16,0" />
                                <CheckBox Content="Invert Y" IsChecked="{Binding InvertY, Mode=TwoWay}" />
                            </StackPanel>

                            <CheckBox Content="Frame pacing (stabilise report timing)"
                                      IsChecked="{Binding FramePacing, Mode=TwoWay}" Margin="0,10,0,0" />

                            <CheckBox x:Name="HotkeysToggle" Content="Enable global hotkeys"
                                      IsChecked="True" Margin="0,10,0,0"
                                      Checked="OnHotkeysToggled" Unchecked="OnHotkeysToggled" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="TELEMETRY" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding StatsText}" Style="{StaticResource ValueText}"
                                       TextWrapping="Wrap" FontSize="11.5" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Report rate" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding PollRateText}"
                                           Style="{StaticResource ValueText}" FontSize="11.5" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Devices" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding DeviceText}"
                                           Style="{StaticResource ValueText}" FontSize="11.5" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Apply now" Style="{StaticResource AccentButton}"
                                        Command="{Binding Commands.Apply}" />
                                <Button Content="Reset stats" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                        Command="{Binding Commands.ResetStats}" />
                                <Button Content="Config folder" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                        Command="{Binding Commands.OpenConfigFolder}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================ footer ============================ -->
        <Grid Grid.Row="2" Margin="2,12,2,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Minimise to tray · changes apply live"
                       Style="{StaticResource Caption}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
